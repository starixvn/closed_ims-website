@{
    ViewBag.Title = "Delete Single Ticket";
}

@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.Models
@*@model Fanex.TicketControl.SportBook.Criteria.GetSingleTicketCriteria*@

@section Head {    
    <link href="~/Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css" rel="stylesheet" type="text/css" />
}

@section Styles {
    <link href="~/Areas/SportBook/Styles/VoidOutrightTicket.less" rel="stylesheet" type="text/css" />
    
}

@section Headline {
    <div class="title">
        <a href="~/">Home</a> / Void Outright Ticket
    </div>
}

@using (Html.BeginForm("Index", "VoidOutrightTicket", FormMethod.Post, new { id = "VoidOutrightTicketForm" }))
{
    <div class="filter-bar">
        <div class="colapse-expand-filter-bar">
            <div>
                <label>
                    <span><i class="icon-minus-sign"></i></span>
                    <span id="collapse-expand-label">Collapse Filter</span>
                </label>
            </div>
        </div>
        <div class="note-filter-bar">
            <div>
                <label>
                    <span><i class="icon-warning-sign"></i></span>
                    You can only delete the unsettled tickets and refunded ones
                </label>
            </div>
        </div>

        <div class="filter-bar-inner">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="ddlLeague">Leagues</label>
                    </div>
                    <div class="edit-field span8">
                        <select style="width:auto" id="ddlLeague" onchange="outright.loadTeamByLeague(this.value)"></select>
                    </div>
                </div>
                             
            </div>
            
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="ddlTeam">Team</label>
                    </div>
                    <div class="edit-field span8">
                        <select id="ddlTeam" style="width:auto" ></select>
                    </div>
                </div>
            </div>
           
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="fromRefno">From BetID</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="fromRefno" maxlength="10" value="" />
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="toRefno">To BetID</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="toRefno" maxlength="10" value=""  />
                    </div>
                </div>  
            </div>

            <div class="filter-row">
                <div class="filter-cell">
                     <div class="lbl-field span3"></div>
                    <div class="edit-field span4">
                        <input type="button" id="btnSearch" class="submit" value="Search" />
                    </div>                    
                </div>
            </div>
        </div>
    </div>
    
    <div id="report-content">
        <div class="display-none content-grid">
            <div class="freegrid " id="matchInfo">
            </div>
        </div>
        <div class="display-none content-grid">
            <div class="freegrid " id="ticketInfo">
            </div>
        </div>
       
        <fieldset id="fsMessage" class="form" style="display: none">
            <legend><span><i class="icon-envelope"></i>&nbsp;</span>Message</legend>
            <h6>
                <em class="em"><u>Note</u>:
                    <br />
                    + Please include "@@@@" in your message for replacing ticket numbers.
                    <br />
                    + English and Mandarin are required.
                    <br />
                    <span><span id="spMoreMsg">[+]</span> <span onclick="helper.displayMoreMsg()" style="cursor: pointer;
                        text-decoration: underline">More Messages</span></span> </em>
            </h6>
            <table>
                <tr>
                    <td>
                        <div>
                            <label for="msg-en">
                                English</label>
                            <textarea rows="1" id="msg-en" class="input-xlarge"></textarea>
                            <label for="msg-ch">
                                Chinese (Mandarin)</label>
                            <textarea rows="1" id="msg-ch" class="input-xlarge"></textarea>
                            <label for="msg-cs">
                                Chinese (Cantonese)</label>
                            <textarea rows="1" id="msg-cs" class="input-xlarge"></textarea>
                        </div>
                    </td>
                    <td style="width: 50px">
                    </td>
                    <td>
                        <div class="other-languages" style="display: none">
                            <label for="msg-en">
                                th</label>
                            <textarea rows="1" id="msg-th" class="input-xlarge"></textarea>
                            <label for="msg-it">
                                It</label>
                            <textarea rows="1" id="msg-it" class="input-xlarge"></textarea>
                            <label for="msg-jp">
                                Jp</label>
                            <textarea rows="1" id="msg-jp" class="input-xlarge"></textarea>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                        <div class="other-languages" style="display: none">
                            <label for="msg-es">
                                Es</label>
                            <textarea rows="1" id="msg-es" class="input-xlarge"></textarea>
                            <label for="msg-ko">
                                Ko</label>
                            <textarea rows="1" id="msg-ko" class="input-xlarge"></textarea>
                        </div>
                    </td>
                </tr>
            </table>
        </fieldset>
        <fieldset id="fsConfirmDelete" class="form" style="display: none">
            <legend><span><i class="icon-trash"></i>&nbsp;</span>Confirm Delete</legend>
            <label for="username"> Username</label>
            <input type="text" id="username" class="input-xlarge" disabled="disabled" value="@ViewBag.Session.Username" />
            <label for="password">
                Password</label>
            <input type="password" id="password" class="input-xlarge" />
            <a class="submit" href="javascript:outright.voidOutrightTicket();">Void Bet</a>
        </fieldset>        
    </div>
}

@section Foot {        
    @Scripts.Render("~/areas/SportBook/VoidOutrightTicket")
}