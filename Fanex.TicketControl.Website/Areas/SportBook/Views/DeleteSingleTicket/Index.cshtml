                    new SelectListItem {
                        Text = "Dead Ball",
                        Value = "1"
                    },
                    new SelectListItem {
                        Text = "Live Ball",
                        Value = "0"
                    }
                };
                        }
                        @Html.DropDownList("EventType", typeList, new { @class = "ddlEventType" })
