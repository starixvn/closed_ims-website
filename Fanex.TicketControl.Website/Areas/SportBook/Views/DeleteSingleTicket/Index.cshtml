                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="txtMatchId">
                            Match ID</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="txtMatchId" maxlength="10" value="3715301" class="validate[required, custom[integer],maxSize[10]]"
                            data-prompt-position="bottomLeft" />
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="fromRefno">
                            From Refno</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="fromRefno" maxlength="10" value="4390869230" class="validate[required, custom[integer],maxSize[10]]"
                            data-prompt-position="bottomLeft" />
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="toRefno">
                            To Refno</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="toRefno" maxlength="10" value="4399301563" class="validate[required, custom[integer],maxSize[10]]"
