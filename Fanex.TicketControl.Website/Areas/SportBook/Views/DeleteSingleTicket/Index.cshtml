@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/Areas/SportBook/Views/DeleteSingleTicket/Styles/DeleteSingleTicket.css" />
}
@section Headline {
    <div class="title">
        <div>
            <span>Special Delete / </span><span class="curr">Delete Single</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field align-left width-auto">
                    <div class="alertboxwrn">
                        <div>
                            You can only delete the unsettled tickets and refunded ones</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    Match Id
                </div>
                <div class="edit-field col_6">
                    <input name="input-field" type="text" value="" class="edit-field" />
                </div>
                <div class="lbl-field col_4 align-right">
                    From TransId
                </div>
                <div class="edit-field col_6">
                    <input name="input-field" type="text" value="" class="" />
                </div>
                <div class="lbl-field col_4 align-right">
                    To TransId
                </div>
                <div class="edit-field col_6">
                    <input name="input-field" type="text" value="" class="" />
                </div>
                <div class="lbl-field col_4 align-right">
                    Filter by
                </div>
                <div class="edit-field col_6">
                    <select id="ddlSAFilter" name="ddlSAFilter" class="col_5">
                        <option selected="selected" value="0">All</option>
                        <option value="1">Normal</option>
                        <option value="2">SA Ticket</option>
                    </select>
                </div>
                @*<div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="SHOW" class="" />
                </div>*@
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    Type
                </div>
                <div class="edit-field col_5" >
                    <select id="ddlLiveIndicator" name="ddlLiveIndicator" class="col_5  alpha omega">
                        <option value="All" selected="selected">All</option>
                        <option value="0">Dead Ball</option>
                        <option value="1">Live Ball</option>
                    </select>
                </div>
                <div class="lbl-field col_2">
                </div>
                <div class="lbl-field col_20 align-left alpha">
                    <input type="text" />
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript" src="~/Areas/SportBook/Views/DeleteSingleTicket/Scripts/DeleteSingleTicket.js"></script>
}
@section Foot {
}
