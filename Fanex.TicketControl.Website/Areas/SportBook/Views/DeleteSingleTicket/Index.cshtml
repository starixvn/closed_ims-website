    var filterByList = new List<SelectListItem> { 
                    new SelectListItem {
                        Text = "All",
                        Value = "0"
                    }, 
                    new SelectListItem {
                        Text = "Normal Tickets",
                        Value = "1"
                    },
                    new SelectListItem {
                        Text = "SA Tickets", 
                        Value = "2"
                    }
                };
                        }
                        @Html.DropDownList("TicketType", filterByList, new { @class = "span5" })
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell event-type-wrp">
                    <div class="lbl-field span3">
                        <label>
                            Event Type</label>
                    </div>
                    <div class="edit-field span4">
