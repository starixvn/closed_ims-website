@{
    ViewBag.Title = "Delete Single Ticket";
}

@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.Models


@section Head {    
    <link href="~/Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css" rel="stylesheet" type="text/css" />
}

@section Styles {
    <link href="~/Areas/SportBook/Styles/DeleteSingleTicket.less" rel="stylesheet" type="text/css" />
}

@section Headline {
    <div class="title">
        <a href="~/">Home</a> / Void Single Ticket
    </div>
}

@using (Html.BeginForm("Index", "DeleteSingleTicket", FormMethod.Post, new { id = "DeleteSingleTicketForm" }))
