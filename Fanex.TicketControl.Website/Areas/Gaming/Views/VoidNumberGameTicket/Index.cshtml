@{
    ViewBag.Title = "Void Number Game Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.Models
@model Fanex.TicketControl.Gaming.Criteria.GetNumberGameTicketCriteria

@section Head {    
    <link href="~/Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css" rel="stylesheet" type="text/css" />
}

@section Styles {
    <link href="~/Areas/Gaming/Styles/VoidNumberGame.less" rel="stylesheet" type="text/css" />
}

@section Headline {
    <div class="title">
        <a href="~/">Home</a> / Void Number Game Bet
    </div>
}

@using (Html.BeginForm("Index", "VoidNumberGameTicket", FormMethod.Post, new { id = "VoidNumberGameTicketForm" }))
{
    <div id="filter-bar">
        <div class="colapse-expand-filter-bar">
            <div>
                <label>
                    <span><i class="icon-minus-sign"></i></span>
                    <span id="collapse-expand-label">Collapse Filter</span>
                </label>
            </div>
        </div>
        <div class="note-filter-bar">
            <div>
                <label>
                    <span><i class="icon-warning-sign"></i></span>
                    You can only delete the unsettled tickets and refunded ones
                </label>
            </div>
        </div>

        <div class="filter-bar-inner">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span2">
                        @Html.LabelFor(m => m.MatchID)
                    </div>
                    <div class="edit-field span5">
                        @Html.TextBox("MatchID", string.Empty, new { maxlength = 10, @class = "text-input width-120" })
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        @Html.LabelFor(m => m.FromRefNo)
                    </div>
                    <div class="edit-field span4">
                        @Html.TextBox("FromRefNo", string.Empty, new { maxlength = 10, @class = "text-input width-120" })
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        @Html.LabelFor(m => m.ToRefNo)
                    </div>
                    <div class="edit-field span4">
                        @Html.TextBox("ToRefNo", string.Empty, new { maxlength = 10, @class = "text-input width-120" })
                    </div>
                </div>
            </div>

            <div class="filter-row tick-list bettype-wrp">
            </div>

            <div class="filter-row">
                <div class="filter-cell">            
                    <input type="submit" class="submit" value="Search"/>
                </div>
            </div>
        </div>
    </div>
}

@section Foot {        
    @Scripts.Render("~/areas/gaming/voidnumbergameticket")
}