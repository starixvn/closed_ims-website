@{
    ViewBag.Title = "Void Number Game Ticket";
}

@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.Models


@section Head {    
    <link href="~/Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css" rel="stylesheet" type="text/css" />
}

@section Styles {
    <link href="~/Areas/Gaming/Styles/VoidNumberGameTicket.less" rel="stylesheet" type="text/css" />
    
}

@section Headline {
    <div class="title">
        <a href="~/">Home</a> / Void Number Game Ticket
    </div>
}

@using (Html.BeginForm("Index", "VoidNumberGameTicket", FormMethod.Post, new { id = "VoidNumberGameTicketForm" }))
{
    <div class="filter-bar">
        <div class="note-filter-bar">
            <i class="icon-warning-sign"></i> 
            @Labels.You_only_void_Unsettled_or_Refunded_tickets
        </div>
        <div class="toggle-filter-bar float-right " title="Collapse filter">
		        <i class="icon-chevron-up"></i>
        </div>
        <div class="clear-fix"></div>
        <div class="filter-bar-inner">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="txtMatchId">@Labels.Match_ID</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="txtMatchId" maxlength="10" value="3861484" />
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="fromRefno">@Labels.From_BetID</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="fromRefno" maxlength="10" value="4435156087" />
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="toRefno">@Labels.To_BetID</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="toRefno" maxlength="10" value="4435167269"  />
                    </div>
                </div>
                
            </div>
            <div class="filter-row tick-list bettype-wrp">
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <input type="button" id="btnSearch" class="submit" value="Search" />
                </div>
            </div>
        </div>
    </div>
    
    <div id="report-content">
        <div class="display-none content-grid">
            <div class="freegrid " id="matchInfo">
            </div>
        </div>
        <div class="display-none content-grid">
            <div class="freegrid " id="ticketInfo">
            </div>
        </div>
       
        <fieldset id="fsMessage" class="form" style="display: none">
            <legend><span><i class="icon-envelope"></i></span>@Labels.Message</legend>
            <h6>
                <em class="em"><u>@Labels.Note</u>:
                    <br />
                    + @Labels.Please_inlude_at_in_message_for_replacing_ticket_numbers
                    <br />
                    + @Labels.English_and_Mandarin_are_required
                    <br />
                    <span><span id="spMoreMsg">[+]</span> <span onclick="helper.displayMoreMsg()" style="cursor: pointer;
                        text-decoration: underline">@Labels.More_Messages</span></span> </em>
            </h6>
            <table>
                <tr>
                    <td>
                        <div>
                            <label for="msg-en">@Labels.English</label>
                            <textarea rows="1" id="msg-en" class="input-xlarge msg-void-ticket"></textarea>
                            <label for="msg-ch">@Labels.Chinese_Mandarin</label>
                            <textarea rows="1" id="msg-ch" class="input-xlarge msg-void-ticket"></textarea>
                            <label for="msg-cs">@Labels.Chinese_Cantonese</label>
                            <textarea rows="1" id="msg-cs" class="input-xlarge msg-void-ticket"></textarea>
                        </div>
                    </td>
                    <td style="width: 50px">
                    </td>
                    <td>
                        <div class="other-languages" style="display: none">
                            <label for="msg-en">@Labels.Th</label>
                            <textarea rows="1" id="msg-th" class="input-xlarge msg-void-ticket"></textarea>
                            <label for="msg-it">@Labels.It</label>
                            <textarea rows="1" id="msg-it" class="input-xlarge msg-void-ticket"></textarea>
                            <label for="msg-jp">@Labels.Jp</label>
                            <textarea rows="1" id="msg-jp" class="input-xlarge msg-void-ticket"></textarea>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                        <div class="other-languages" style="display: none">
                            <label for="msg-es">@Labels.Es</label>
                            <textarea rows="1" id="msg-es" class="input-xlarge msg-void-ticket"></textarea>
                            <label for="msg-ko">@Labels.Ko</label>
                            <textarea rows="1" id="msg-ko" class="input-xlarge msg-void-ticket"></textarea>
                        </div>
                    </td>
                </tr>
            </table>
        </fieldset>
        <fieldset id="fsConfirmDelete" class="form" style="display: none">
            <legend><span><i class="icon-trash"></i></span>@Labels.Confirm_Delete</legend>
            <label for="username">@Labels.Username</label>
            <input type="text" id="username" class="input-xlarge" disabled="disabled" value="@ViewBag.Session.Username" />
            <label for="password">@Labels.Password</label>
            <input type="password" id="password" class="input-xlarge" />
            <a class="submit" href="javascript:;voidNumberGame.voidNumberGameTicket();">@Labels.Void_Bet</a>
        </fieldset>
    </div>
}

@section Foot {        
    @Scripts.Render("~/areas/Gaming/VoidNumberGameTicket")
}