@{
    ViewBag.Title = "Recover Number Game Ticket";
}

@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.Models

@section Head {    
    <link href="~/Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css" rel="stylesheet" type="text/css" />
}

@section Styles {
    <link href="~/Areas/Gaming/Styles/RecoverNumberGameTicket.less" rel="stylesheet" type="text/css" />
    
}

@section Headline {
    <div class="title">
        <a href="~/">Home</a> / Recover Number Game Ticket
    </div>
}

@using (Html.BeginForm("Index", "RecoverNumberGameTicket", FormMethod.Post, new { id = "RecoverNumberGameTicketForm" }))
{
    <div class="filter-bar">
        <div class="filter-bar-inner">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <label for="txtBetId">Bet ID</label>
                    </div>
                    <div class="edit-field span4">
                        <input type="text" id="txtBetId" maxlength="10" value="" />
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <input type="button" value="Search" class="submit" id="btnSearch"/>
                    </div>                  
                </div>                
            </div>   
        </div>     
    </div>
    
    <div id="report-content">
        <div class="display-none content-grid">
            <div class="freegrid " id="matchInfo">
            </div>
        </div>
        <div class="display-none content-grid">
            <div class="freegrid " id="ticketInfo">
            </div>
        </div>
        @Html.Partial("_Message")
    </div>
}

@section Foot {        
    @Scripts.Render("~/areas/Gaming/RecoverNumberGameTicket")
}