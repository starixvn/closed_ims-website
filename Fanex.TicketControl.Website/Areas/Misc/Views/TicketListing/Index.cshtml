﻿@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Fanex.TicketControl.Misc.Criteria.GetTicketsListingCriteria

@section Head {    
    <link href="~/Areas/Misc/Styles/TicketListing.less" rel="stylesheet" type="text/css" />
}

@section Headline {
    <div class="title">
        <div>
            <span>Special Delete / </span><span class="curr">Ticket Listing</span>
        </div>
        <div id="ErrMsg" class="col_35 display-none width-auto"></div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_2 align-right">
                    @Html.LabelFor(m => m.MatchID)
                </div>
                <div class="edit-field  col_7">
                    @Html.TextBox("MatchID", string.Empty, new { @class="col_6" })
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Html.LabelFor(m => m.LicenseeID)
                </div>
                <div class="edit-field col_8">
                @{
                    var licenseeList = new List<SelectListItem>{
                        new SelectListItem {
                            Text = "All",
                            Value = "0"
                        }, 
                        new SelectListItem {
                            Text = "IBC Group",
                            Value = "-1"
                        }
                    };
                }
                    @Html.DropDownList("LicenseeID", licenseeList, new { 
                        @class = "col180",
                        id = "ddlLicensee"
                    })
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Html.LabelFor(m => m.GroupBy)
                </div>
                <div class="edit-field  col_8">
                    @{
                        var groupByList = new List<SelectListItem> { 
                            new SelectListItem {
                                Text = "Licensee and Bet type",
                                Value = "0"
                            }, 
                            new SelectListItem {
                                Text = "Bet type and Licensee",
                                Value = "1"
                            }
                        };
                    }
                    @Html.DropDownList("GroupBy", groupByList, new { @class="col180"})
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Html.LabelFor(m => m.SAFilter)
                </div>
                <div class="edit-field col3">
                    @{
                        var filterByList = new List<SelectListItem> { 
                            new SelectListItem {
                                Text = "All",
                                Value = "0"
                            }, 
                            new SelectListItem {
                                Text = "Normal Tickets",
                                Value = "1"
                            },
                            new SelectListItem {
                                Text = "SA Tickets", 
                                Value = "2"
                            }
                        };
                    }
                    @Html.DropDownList("SAFilter", filterByList, new { @class="col180"})
                </div>
            </div>
        </div>
        <div class="filter-row control-live-type">
            <div class="filter-cell">
                <div class="lbl-field col_2 align-right">
                    @Html.LabelFor(m => m.LiveType)
                </div>
                <div class="edit-field  col_7">
                @{
                    var typeList = new List<SelectListItem> { 
                        new SelectListItem {
                            Text = "All",
                            Value = "2"
                        }, 
                        new SelectListItem {
                            Text = "Dead Ball",
                            Value = "1"
                        },
                        new SelectListItem {
                            Text = "Live Ball",
                            Value = "0"
                        }
                    };
                }
                    @Html.DropDownList("LiveType", typeList, new { @class="col_6", id="ddlLiveType"})
                </div>
            </div>
            <div class="filter-cell type-title">
                <fieldset >
                    <legend>Title</legend>
                    <div class="lbl-field col_3 align-left bold">
                        Live Score
                    </div>
                    <div class="lbl-field  col80">
                        @Html.LabelFor(m => m.LiveHomeScore)
                        @Html.TextBox("LiveHomeScore", string.Empty, new { @class = "col20" })
                    </div>
                    <div class="lbl-field  col80">
                        @Html.LabelFor(m => m.LiveAwayScore)
                        @Html.TextBox("LiveAwayScore", string.Empty, new { @class = "col20" })                        
                    </div>
                    <div class="lbl-field col170 align-center bold">
                        Date Time (GMT+ 8)
                    </div>
                    <div class="lbl-field  col_1">                        
                        <input type="checkbox" class="chkDateRange" />
                    </div>
                    <div class="lbl-field col_2 align-right">
                        @Html.LabelFor( m => m.FromTransDate)
                    </div>
                    <div class="edit-field col_6">
                        @Html.TextBox("FromTransDate", string.Empty, new { @class="txtCalendar"})
                    </div>
                    <div class="lbl-field col_1">
                        @Html.LabelFor( m => m.ToTransDate)
                    </div>
                    <div class="edit-field col_6">
                        @Html.TextBox("ToTransDate", string.Empty, new { @class="txtCalendar"})
                    </div>
                </fieldset>            
            </div>
        </div>
        @*<div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
                <div id="ErrMsg1" class="col_35 display-none width-auto">
                </div>
                <div id="ErrMsg2" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>*@
        <div class="filter-row">
            <div class="filter-cell products">
                <div class="edit-field col_17">
                    <input type="radio" name="Type" id="Sportsbook" class="product" checked="checked" value="Sportsbook" />
                    <label for="Sportsbook">Sportsbook</label>
                    &nbsp;
                    <input type="radio" name="Type" id="NumberGame" class="product" value="NumberGame" />
                    <label for="NumberGame">Number Game</label>
                    &nbsp;
                    <input type="radio" name="Type" id="LiveCasino" class="product" value="LiveCasino" />
                    <label for="LiveCasino">Live Casino</label>
                    &nbsp;
                    <input type="radio" name="Type" id="VirtualSports" class="product" value="VirtualSports"/>
                    <label for="VirtualSports">Virtual Sports</label>
                </div>
            </div>
        </div>
        <div class="filter-row bettypes">
            <table class="normal-table">
                <thead>
                    <tr>
                        <th colspan="5">
                            <input id="chkallbettype" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkallbettype">
                                All Bet types</label>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="l col150">
                            <input id="chkbettype_1" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_1">
                                Handicap</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_2" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_2">
                                Odd/Even</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_3" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_3">
                                Over/Under</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_4" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_4">
                                Correct Score</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_5" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_5">
                                FT.1X2</label>
                        </td>
                    </tr>
                    <tr>
                        <td class="l col150">
                            <input id="chkbettype_11" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_11">
                                Handicap</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_21" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_21">
                                Odd/Even</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_31" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_31">
                                Over/Under</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_41" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_41">
                                Correct Score</label>
                        </td>
                        <td class="l col150">
                            <input id="chkbettype_51" class="chkbettype" type="checkbox" checked="checked">
                            <label for="chkbettype_51">
                                FT.1X2</label>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="SHOW" class="" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Foot {
    <script src="../../../../Scripts/_Libs/jQuery/jquery-ui-1.9.1.min.js" type="text/javascript"></script>
    <script src="../../../../Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.js"
        type="text/javascript"></script>
    <script src="~/Areas/Misc/Scripts/TicketListing.js" type="text/javascript"></script>
    <script src="~/Areas/Misc/Scripts/TicketListingManager.js" type="text/javascript"></script>

    <script type="text/javascript">
        $(function () {
            $('#ErrMsg').showErrorMessage(["Demo Message", "Demo Message", "Demo Message"]);
            $('#ErrMsg1').showWarningMessage("Demo Message");
            $('#ErrMsg2').showSuccessMessage("Demo Message");
        });
    </script>

}