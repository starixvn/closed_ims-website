@{
    ViewBag.Title = "Ticket Listing";
}

@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.Models
@model Fanex.TicketControl.Misc.Criteria.GetTicketsListingCriteria

@section Head {    
    <link href="~/Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css" rel="stylesheet" type="text/css" />
}

@section Styles {
    <link href="~/Areas/Misc/Styles/TicketListing.less" rel="stylesheet" type="text/css" />
}

@section Headline {
    <div class="title">
        <a href="~/">Home</a> / Ticket Listing
    </div>
}

@using (Html.BeginForm("Index", "TicketListing", FormMethod.Post, new { id = "TicketListingForm" }))
{
<div class="filter-bar">
    <div class="filter-bar-inner">
    <div class="filter-row">
        <div class="filter-cell">
            <div class="lbl-field span2">
                @Html.LabelFor(m => m.MatchID)
            </div>
            <div class="edit-field span4">
                @Html.TextBox("MatchID", string.Empty, new {maxlength=10, @class="validate[required,custom[integer]] text-input" })
                
            </div>
        </div>
        <div class="filter-cell">
            <div class="lbl-field span3">                
                @Html.LabelFor(m => m.LicenseeID)
            </div>
            <div class="edit-field span4">
            @{
                var licenseeList = new List<SelectListItem>{
                    new SelectListItem {
                        Text = "All",
                        Value = "0"
                    }, 
                    new SelectListItem {
                        Text = "IBC Group",
                        Value = "-1"
                    }
                };
            }
                @Html.DropDownList("LicenseeID", licenseeList, new { @class = "ddlLicensee" })
            </div>
        </div>
        <div class="filter-cell">
            <div class="lbl-field span3">
                @Html.LabelFor(m => m.GroupBy)
            </div>
            <div class="edit-field span6">
            @{
                var groupByList = new List<SelectListItem> { 
                    new SelectListItem {
                        Text = "Licensee and Bet type",
                        Value = "0"
                    }, 
                    new SelectListItem {
                        Text = "Bet type and Licensee",
                        Value = "1"
                    }
                };
             }
                @Html.DropDownList("GroupBy", groupByList)
            </div>
        </div>
        <div class="filter-cell">
            <div class="lbl-field span3">
                @Html.LabelFor(m => m.SAFilter)
            </div>
            <div class="edit-field span5">
            @{
                var filterByList = new List<SelectListItem> { 
                    new SelectListItem {
                        Text = "All",
                        Value = "0"
                    }, 
                    new SelectListItem {
                        Text = "Normal Tickets",
                        Value = "1"
                    },
                    new SelectListItem {
                        Text = "SA Tickets", 
                        Value = "2"
                    }
                };
            }
                @Html.DropDownList("SAFilter", filterByList, new { @class = "span5" })
            </div>
        </div>
    </div>
    <div class="filter-row">
        <div class="filter-cell">
            <div class="edit-field span13">
                <div class="tick-list">
                    <input type="radio" id="Sportsbook" name="Product" class="product" checked="checked" value="@ProductType.Sportsbook" />
                    <label for="Sportsbook">@Labels.Sportsbook</label>
                    <input type="radio" id="NumberGame" name="Product" class="product" value="@ProductType.NumberGame" />
                    <label for="NumberGame">@Labels.Number_Game</label>
                    <input type="radio" id="LiveCasino" name="Product" class="product" value="@ProductType.LiveCasino" />
                    <label for="LiveCasino">@Labels.Live_Casino</label>
                    <input type="radio" id="VirtualSports" name="Product" class="product" value="@ProductType.VirtualSports" />
                    <label for="VirtualSports">@Labels.Virtual_Sports</label>
                </div>
            </div>
        </div>
        <div class="filter-cell event-type-wrp">
            <div class="lbl-field span3">
                @Html.LabelFor(m => m.LiveType)
            </div>
            <div class="edit-field span4">
            @{
                var typeList = new List<SelectListItem> { 
                    new SelectListItem {
                        Text = "All",
                        Value = "2"
                    }, 
                    new SelectListItem {
                        Text = "Dead Ball",
                        Value = "1"
                    },
                    new SelectListItem {
                        Text = "Live Ball",
                        Value = "0"
                    }
                };
            }
                @Html.DropDownList("LiveType", typeList, new { @class = "ddlEventType" })
            </div>
        </div>
    </div>
    <div class="filter-row opt-filters" style="display: none;">
        <fieldset>
            <legend><i class="icon-filter"></i>Optional Filters</legend>
            <div class="lbl-field">
                <label for="LiveHomeScore" class="bold">@Labels.Live_Score: </label>
            </div>
            <div class="edit-field live-score">
                @Html.LabelFor(m => m.LiveHomeScore)
                @Html.TextBox("LiveHomeScore", string.Empty)
                @Html.LabelFor(m => m.LiveAwayScore)
                @Html.TextBox("LiveAwayScore", string.Empty)        
            </div>
            <div class="lbl-field span5">
                <label for="TransDate" class="bold">@Labels.Trans_Date_GMT8:</label>
            </div>
            <div class="edit-field datetime">
                <input type="checkbox" class="chkTransDateRange" id="TransDate"/>
                @Html.LabelFor(m => m.FromTransDate)                
                @Html.TextBox("FromTransDate", string.Empty, new { @readonly = "readonly", @class = "txtCalendar width-140" })
                @Html.LabelFor(m => m.ToTransDate)
                @Html.TextBox("ToTransDate", string.Empty, new { @readonly = "readonly", @class = "txtCalendar width-140" })
            </div>
        </fieldset>
    </div>
    <div class="filter-row tick-list bettype-wrp">
    </div>
    <div class="filter-row">
        <div class="filter-cell">            
            <input type="submit" class="submit" value="Generate"/>
        </div>
    </div>
    </div>
</div>
}

@section Foot {
    @Scripts.Render("~/areas/misc/ticketlisting")
}