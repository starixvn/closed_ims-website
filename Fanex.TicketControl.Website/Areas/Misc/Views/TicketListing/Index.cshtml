﻿@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.Models

@model Fanex.TicketControl.Misc.Criteria.GetTicketsListingCriteria

@section Head {    
    <link href="../../../../Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css"
        rel="stylesheet" type="text/css" />
    <link href="~/Areas/Misc/Styles/TicketListing.less" rel="stylesheet" type="text/css" />
}

@section Headline {
    <div class="title">
        <div>
            <span>Special Delete / </span><span class="curr">Ticket Listing</span>
        </div>
        <div id="ErrMsg" class="col_35 display-none width-auto"></div>
    </div>
}

@using (Html.BeginForm("Index", "TicketListing", FormMethod.Post, new { id = "TicketListingForm" }))
{
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_2 align-right">
                    @Html.LabelFor(m => m.MatchID)
                </div>
                <div class="edit-field  col_7">
                    @Html.TextBox("MatchID", string.Empty, new { @class = "col_6" })
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Html.LabelFor(m => m.LicenseeID)
                </div>
                <div class="edit-field col_8">
                @{
    var licenseeList = new List<SelectListItem>{
                        new SelectListItem {
                            Text = "All",
                            Value = "0"
                        }, 
                        new SelectListItem {
                            Text = "IBC Group",
                            Value = "-1"
                        }
                    };
                }
                    @Html.DropDownList("LicenseeID", licenseeList, new
               {
                   @class = "col180",
                   id = "ddlLicensee"
               })
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Html.LabelFor(m => m.GroupBy)
                </div>
                <div class="edit-field  col_8">
                    @{
    var groupByList = new List<SelectListItem> { 
                            new SelectListItem {
                                Text = "Licensee and Bet type",
                                Value = "0"
                            }, 
                            new SelectListItem {
                                Text = "Bet type and Licensee",
                                Value = "1"
                            }
                        };
                    }
                    @Html.DropDownList("GroupBy", groupByList, new { @class = "col180" })
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Html.LabelFor(m => m.TicketType)
                </div>
                <div class="edit-field col3">
                    @{
    var filterByList = new List<SelectListItem> { 
                            new SelectListItem {
                                Text = "All",
                                Value = "0"
                            }, 
                            new SelectListItem {
                                Text = "Normal Tickets",
                                Value = "1"
                            },
                            new SelectListItem {
                                Text = "SA Tickets", 
                                Value = "2"
                            }
                        };
                    }
                    @Html.DropDownList("TicketType", filterByList, new { @class = "col180" })
                </div>
            </div>
        </div>

        <div class="filter-row">
            <div class="filter-cell products">
                <div class="edit-field col_17">
                    <input type="radio" name="Product" id="Sportsbook" class="product" checked="checked" value="@ProductType.Sportsbook" />
                    <label for="Sportsbook">@Labels.Sportsbook</label>
                    &nbsp;
                    <input type="radio" name="Product" id="NumberGame" class="product" value="@ProductType.NumberGame" />
                    <label for="NumberGame">@Labels.Number_Game</label>
                    &nbsp;
                    <input type="radio" name="Product" id="LiveCasino" class="product" value="@ProductType.LiveCasino" />
                    <label for="LiveCasino">@Labels.Live_Casino</label>
                    &nbsp;
                    <input type="radio" name="Product" id="VirtualSports" class="product" value="@ProductType.VirtualSports"/>
                    <label for="VirtualSports">@Labels.Virtual_Sports</label>
                </div>
            </div>
        </div>

        <div class="filter-row control-live-type">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    @Html.LabelFor(m => m.EventType)
                </div>
                <div class="edit-field  col_7">
                @{
    var typeList = new List<SelectListItem> { 
                        new SelectListItem {
                            Text = "All",
                            Value = "2"
                        }, 
                        new SelectListItem {
                            Text = "Dead Ball",
                            Value = "1"
                        },
                        new SelectListItem {
                            Text = "Live Ball",
                            Value = "0"
                        }
                    };
                }
                    @Html.DropDownList("EventType", typeList, new { @class = "col_6", id = "ddlLiveType" })
                </div>
            </div>
            
            <div class="filter-cell type-title">
                <fieldset >
                    <legend>Title</legend>
                    <div class="lbl-field col_3 align-left bold">
                        @Labels.Live_Score
                    </div>
                    <div class="lbl-field  col80">
                        @Html.LabelFor(m => m.LiveHomeScore)
                        @Html.TextBox("LiveHomeScore", string.Empty, new { @class = "col20" })
                    </div>
                    <div class="lbl-field  col80">
                        @Html.LabelFor(m => m.LiveAwayScore)
                        @Html.TextBox("LiveAwayScore", string.Empty, new { @class = "col20" })                        
                    </div>
                    <div class="lbl-field col170 align-center bold">
                        @Labels.Trans_Date_GMT8
                    </div>
                    <div class="lbl-field  col_1">                        
                        <input type="checkbox" class="chkTransDateRange" />
                    </div>
                    <div class="lbl-field col_2 align-right">
                        @Html.LabelFor(m => m.FromTransDate)
                    </div>
                    <div class="edit-field col_6">
                        @Html.TextBox("FromTransDate", string.Empty, new { @readonly = "readonly", @class = "txtCalendar" })
                    </div>
                    <div class="lbl-field col_1">
                        @Html.LabelFor(m => m.ToTransDate)
                    </div>
                    <div class="edit-field col_6">
                        @Html.TextBox("ToTransDate", string.Empty, new { @readonly = "readonly", @class = "txtCalendar" })
                    </div>
                </fieldset>            
            </div>
        </div>

        <div class="filter-row control-bettypes">            
        </div>

        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="Generate" class="" />
                </div>
            </div>
        </div>
    </div>
</div>
}

@section Foot {
    <script src="../../../../Scripts/_Libs/jQuery/jquery-ui-1.9.1.min.js" type="text/javascript"></script>
    <script src="../../../../Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.js"
        type="text/javascript"></script>
    <script src="../../../../Scripts/_Libs/Utils/stdlib.js" type="text/javascript"></script>
    <script src="~/Areas/Misc/Scripts/TicketListing.js" type="text/javascript"></script>
    <script src="~/Areas/Misc/Scripts/TicketListingManager.js" type="text/javascript"></script>

    <script type="text/javascript">
        $(function () {
            $('#ErrMsg').showErrorMessage(["Demo Message", "Demo Message", "Demo Message"]);
            $('#ErrMsg1').showWarningMessage("Demo Message");
            $('#ErrMsg2').showSuccessMessage("Demo Message");
        });
    </script>

}