@using Fanex.TicketControl.Core.Configurations;
@using Fanex.TicketControl.Core.Models;
@using Fanex.TicketControl.Core.Services.Impl;
@using Fanex.TicketControl.Core.Resources;
@using Fanex.TicketControl.Core.Web;
@using Fanex.NAP.Core.Web;
@using Newtonsoft.Json;
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>@ViewBag.Title</title>
    <meta http-equiv="cleartype" content="on" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <script src="~/Scripts/_Libs/Utils/html5shiv.min.js" type="text/javascript"></script>
    @Styles.Render("~/Themes/style", "~/Scripts/_Libs/Tooltip/style", "~/Themes/base/jquery/style")
    <link type="text/css" rel="Stylesheet" href="~/Scripts/_Libs/FanexGrid/Fanex.Grid.css?ver=2" />
    <link type="text/css" rel="Stylesheet" href="~/Themes/base/style.less" />
    @RenderSection("Head", false)
</head>
<body>
    <header>
        <div class="logo">
            <a href="~/?ref=logo">&nbsp;</a>
        </div>
        @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
        <div class="user-info">
            <div class="greeting">
                <h2>
                    Welcome <span class="info-acc">@HttpContext.Current.User.Identity.Name</span><span
                        class="info-more"></span></h2>
                <ul>
                    <li>@Html.ActionLink(ViewResources.Profile, "UserProfile", "User", new { Area = "UserControl" }, new { })</li>
                    <li>@Html.ActionLink(ViewResources.Change_Password, "ChangePassword", "User", new { Area = "UserControl" }, new { })</li>
                    <li>@Html.ActionLink(ViewResources.Sign_Out, "LogOut", "Login", new { Area = "UserLogin" }, new { })</li>
                </ul>
            </div>
        </div>
    </header>
    <section id="headline">
        @RenderSection("Headline", false)
    </section>
    <section id="body">
        <div class="content">
            @RenderBody()
        </div>
    </section>
    <div id="dialog-message">
    </div>
    <div id="dialog-popup">
    </div>
</body>
</html>
@Html.Hidden("TicketControlRoot", Url.Content("~/Admin/"))
@Html.Hidden("NapRoot", Url.Content("~/"))
@Scripts.Render("~/Scripts-bundle/jquery")
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    window.rootWebPath = '@(Request.Url.GetLeftPart(UriPartial.Authority) + Request.ApplicationPath)';
</script>
@RenderSection("Scripts", false)
@RenderSection("Foot", false)
