<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title &mdash; NAP Special Delete</title>
    <link rel="shortcut icon" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--[if lt IE 9]><script src="~/scripts/_libs/utils/html5shiv.min.js" type="text/javascript"></script><![endif]-->

    <link href="~/content/jquery-ui/jquery-ui-1.9.1.custom.min.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/_libs/fanexgrid/fanex.grid.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/_Libs/Validation/validationEngine.jquery.css" rel="stylesheet" type="text/css" />

@RenderSection("Head", false)

@if (IsSectionDefined("Styles"))
{
    @RenderSection("Styles")
} else {
    <link href="~/content/base/styles.less" rel="stylesheet" type="text/css" />
}
</head>
<body>
    <header>
        <a class="logo" href="~/?ref=logo"><span>Special</span> <span class="del">ELETE</span></a>
        @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
        <div class="user-info">
                Howdy,
                <em>@HttpContext.Current.User.Identity.Name</em>
                <i class="icon-chevron-down icon-white"></i>
            <ul>
                <li><a href="@Url.Action("UserProfile", "User", new { Area = "UserControl" })">
                    <i class="icon-user icon-white"></i> &bull; @ViewResources.Profile</a></li>
                <li><a href="@Url.Action("ChangePassword", "User", new { Area = "UserControl" })">
                    <i class="icon-refresh icon-white"></i> &bull; @ViewResources.Change_Password</a></li>
                <li><a href="@Url.Action("LogOut", "LogIn", new { Area = "UserLogin" })">
                    <i class="icon-share icon-white"></i> &bull; @ViewResources.Sign_Out</a></li>
            </ul>
        </div>
    </header>
    <section id="headline">
        @RenderSection("Headline", false)
    </section>
    <section id="body">
        @RenderBody()
    </section>

    <div class="alert alert-success" id="msg-box">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <div class="alert-content">
            <b>Bet transactions deleted!</b>
            <span class="error">Email sent to ricky shit</span><br />
            <span class="success">Email sent to ricky shit</span><br />
            Email sent to ricky shit<br />
            Email sent to ricky shit<br />
        </div>
    </div>

    <div class="loader">
        <img src="~/content/img/loader.gif" alt="loading..." />
    </div>
</body>
</html>
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    window.rootWebPath = '@(Request.Url.GetLeftPart(UriPartial.Authority) + Request.ApplicationPath)';
</script>
@Scripts.Render("~/scripts/common")
@RenderSection("Foot", false)