@using Fanex.Ares.Report.ViewModels.LicenseeSettlement;
@using Fanex.Ares.Core.Extensions;
@using Fanex.Ares.Core.DataDomain;
@using Fanex.Ares.Core.Resources;
@model LicenseeSettlementModel
@{
    var reportCount = Model.ReportList.Count;
    var baseCurrencyName = Model.LicenseeInfor.BaseCurrencyName;
    var forexNote = string.Format(Labels.OandaNote, baseCurrencyName, baseCurrencyName, baseCurrencyName);
    var idrNote = string.Format(Labels.IDRNote, baseCurrencyName);
}
<link rel="stylesheet" type="text/css" href="~/Areas/Invoice/Views/Invoice/Styles/LicenseeSettlement.css" />
<link rel="stylesheet" type="text/css" href="~/Areas/Invoice/Views/Invoice/Styles/LicenseeSettlementWeb.css" />
<div class="div-content">
    <table class="table-content" cellpadding="2" cellspacing="0">
        <tr>
            <td colspan="15" class="boldTilte height16">
                INTERNAL WORKSHEET FOR SETTLEMENT
            </td>
        </tr>
        <tr>
            <td class="colNote height12" colspan="3">
                Finance Department
            </td>
            <td colspan="12">
            </td>
        </tr>
        <tr>
            <td colspan="15" class="height12">
            </td>
        </tr>
        <tr>
            <td class="colNote height12" colspan="2">
                SETTLEMENT REPORT
            </td>
            <td class="boldInfor" colspan="13">
                From @Model.LicenseeInfor.FromDate.ToAresDayMonthYear()
                To @Model.LicenseeInfor.ToDate.ToAresDayMonthYear()
            </td>
        </tr>
        <tr>
            <td class="colNote height12">
                LICENSEE:
            </td>
            <td colspan="1" class="licenseeName">
                @Model.LicenseeInfor.LicenseeName
            </td>
            <td class="sportName" colspan="3">
                @Model.LicenseeInfor.ProductName.ToUpper()
            </td>
            <td class="colNote" colspan="2">
                1st Billing:
            </td>
            <td class="boldInfor" colspan="8">
                @Model.LicenseeInfor.FirstBilling.ToAresMonthYear()
            </td>
        </tr>
        @{
            var billingTmp = Model.LicenseeInfor.BasisOfBilling == null ? string.Empty : Model.LicenseeInfor.BasisOfBilling;
            string[] basicBillingList = billingTmp.Split(';');
            int index = 0;
        }
        @foreach (string basicBilling in basicBillingList)
        {
            <tr>
                <td colspan="5" class="height12">
                </td>
                <td class="colNote" colspan="2">
                    @if (index == 0)
                    {
                        <span>Basis of Billing:</span>
                    }
                </td>
                <td class="boldInfor" colspan="8">
                    @basicBilling
                </td>
            </tr>
                    index++;
        }
        <tr>
            <td colspan="15" class="height12">
            </td>
        </tr>
        <tr>
            <td colspan="5" class="height12">
            </td>
            <td class="colNote" colspan="2">
                Minimum Fees:
            </td>
            <td class="boldInfor" colspan="8">
                @Model.LicenseeInfor.MinimumFees
            </td>
        </tr>
        <tr>
            <td colspan="5" class="height12">
            </td>
            <td class="colNote" colspan="2">
                Head of Terms:
            </td>
            <td class="boldInfor" colspan="8">
                @Model.LicenseeInfor.HeadOfTerms
            </td>
        </tr>
        <tr>
            <td colspan="12" class="height12">
            </td>
        </tr>
        <tr>
            <td rowspan="2" class="header height26">
                @Labels.Date
            </td>
            <td rowspan="2" class="header">
                &nbsp;@Labels.Currency&nbsp;
            </td>
            <td rowspan="2" class="header">
                @Labels.Turnover
            </td>
            <td rowspan="2" class="header">
                @Labels.TotalTrans
            </td>
            <td colspan="3" class="header">
                @Labels.Member
            </td>
            <td colspan="3" class="header">
                @Model.LicenseeInfor.LicenseeName
            </td>
            <td rowspan="2" class="header">
                @Labels.Company
            </td>
            <td rowspan="2" class="header">
                @Model.LicenseeInfor.BaseCurrencyName
            </td>
            <td rowspan="2" class="emptyheader">
            </td>
            <td colspan="2" class="header">
                @{
                    string forexTime = string.Empty;
                    if (DateTime.Now.Year == Model.LicenseeInfor.SettlementDate.Year && DateTime.Now.Month == Model.LicenseeInfor.SettlementDate.Month)
                    {
                        forexTime = DateTime.Now.ToAresDayMonthYear();
                    }
                    else
                    {
                        forexTime = Model.LicenseeInfor.SettlementDate.LastDayOfMonth().ToAresDayMonthYear();
                    }
                }
                Forex @@ @forexTime
            </td>
        </tr>
        <tr>
            <td class="header">
                @Labels.WinLoss
            </td>
            <td class="header">
                @Labels.Comm
            </td>
            <td class="header">
                @Labels.Total
            </td>
            <td class="header">
                @Labels.WinLoss
            </td>
            <td class="header">
                @Labels.Comm
            </td>
            <td class="header">
                @Labels.Total
            </td>
            <td class="header">
                @Model.LicenseeInfor.BaseCurrencyName/1&nbsp;Unit
            </td>
            <td class="header">
                Units/1&nbsp;@Model.LicenseeInfor.BaseCurrencyName
            </td>
        </tr>
        @if (reportCount == 0)
        {
            <tr>
                <td class="cell-content aligncenter colText" colspan="12">
                    There is no data
                </td>
                <td>
                </td>
                <td class="cell-content aligncenter colText" colspan="2">
                    There is no data
                </td>
            </tr>
        }
        else
        {
            for (int i = 0; i < reportCount; i++)
            {
                var report = Model.ReportList[i];
                var exchange = Model.ExchangeList[i];
                var evenClass = NumberExtensions.GetEvenClass(i);
            
            <tr>
                <td class="colDateTime cell-content height15 @evenClass">
                    @report.WinlostDate.ToAresDayMonthYear()
                </td>
                <td class="colText cell-content @evenClass" >
                    @report.CurrencyName
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @Html.Raw(NumberExtensions.NegativeFormat(report.Turnover))
                </td>
                <td class="colInteger cell-content @evenClass" >
                    @report.Betcount.Format(0)
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @Html.Raw(NumberExtensions.NegativeFormat(report.MemberWinloss))
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @if (report.MemberComm != 0)
                    {
                        @Html.Raw(NumberExtensions.NegativeFormat(report.MemberComm))
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @Html.Raw(NumberExtensions.NegativeFormat(report.MemberTotal))
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @Html.Raw(NumberExtensions.NegativeFormat(report.LicenseeWL))
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @if (report.LicenseeComm != 0)
                    {
                        @Html.Raw(NumberExtensions.NegativeFormat(report.LicenseeComm))
                    }
                    else
                    { 
                        <span>-</span>
                    }
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @Html.Raw(NumberExtensions.NegativeFormat(report.LicenseeTotal))
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @Html.Raw(NumberExtensions.NegativeFormat(report.Company))
                </td>
                <td class="colNumber cell-content @evenClass" >
                    @Html.Raw(NumberExtensions.NegativeFormat(report.CompanyBaseCurrency))
                </td>
                <td class="currency">
                    @exchange.CurrencyName
                </td>
                <td class="colNumber5Odd cell-content @evenClass" >
                    @exchange.BasePerUnit.Format(5)
                </td>
                <td class="colNumber5Odd cell-content @evenClass" >
                    @exchange.UnitsPerBase.Format(5)
                </td>
            </tr>
            }
            <tr>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td class="grandtotal">
                </td>
                <td align="right" class="grandtotal">
                    @Html.Raw(NumberExtensions.NegativeFormat(Model.GrandTotal.CompanyBaseCurrency))
                </td>
                <td class="emptyCell">
                </td>
                <td class="emptytotal height10" colspan="2">
                </td>
            </tr>
            <tr>
                <td colspan="12">
                    <div>
                        <hr />
                    </div>
                </td>
            </tr>
            if (!Model.LicenseeInfor.BaseCurrencyName.Trim().Equals(BaseCurrencyName.CNY))
            {
            <tr>
                <td class="colNote height15">
                    IDR &amp; VND *
                </td>
                <td colspan="14" class="colNote">
                    @idrNote
                </td>
            </tr>
            <tr>
                <td class="colNote height15">
                    FOREX
                </td>
                <td colspan="14" class="colNote">
                    @forexNote
                </td>
            </tr>
            }
        }
    </table>
</div>
