@using Fanex.Ares.Invoice.Models.Invoice;
@{
    InvoiceModel model = new InvoiceModel();
    int i = 0;
}
<style type="text/css">
    table, th, td
    {
        background: #EDECEA;
        border: 1px solid #CECCCD;
        text-align: center;
        vertical-align: middle;
    }
    
    
    th
    {
        background-color: #E9E480;
        color: black;
        font-weight: bold;
    }
    table
    {
        border-collapse: collapse;
    }
    
    textarea#styled
    {
        width: 95%;
        height: 40px;
        border: 1px solid #cccccc;
        padding: 5px;
        font-family: Tahoma, sans-serif;
        background-image: url(bg.gif);
        background-position: bottom right;
        background-repeat: no-repeat;
    }
    
    
    .noneBorder
    {
        border: 0px !important;
    }
    
    .paddingLeft
    {
        text-align: left;
        padding-left: 5px;
    }
    
    .height20
    {
        height: 20px;
    }
    
    .label
    {
        width: 70%;
        font-weight: bold;
         background-color:#9A9696 !important; 
         display: inline-block;
    }
</style>
<div class="div-content" style="overflow: auto; width: 100%; padding-top: 20px; margin: 0px !important;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style='border-collapse: collapse;'>
        <tr>
            <td>
                <table style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="height: 34px;">
                                ITEM
                            </th>
                            <th>
                                DESCRIPTION
                            </th>
                            <th>
                                REFERENCE
                            </th>
                            <th>
                                AMOUNT
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (StatementDetail statementDetail in model.Statement.StatementList)
                        {
                            <tr style="width: 100%; text-align: center;">
                                <td style="width: 10%;">
                                    @statementDetail.ID
                                </td>
                                <td style="width: 55%; text-align: center; height: 60px;">
                                    <textarea rows="2" cols="106" name="styled-textarea" id="styled_@i" onfocus="setbg('#e5fff3',@i);" onblur="setbg('white',@i)">@statementDetail.Description</textarea>
                                </td>
                                @{
                            i++;
                                }
                                <td style="width: 20%; text-align: center;">
                                    <textarea rows="2" cols="33" name="styled-textarea" id="styled_@i" onfocus="setbg('#e5fff3',@i);" onblur="setbg('white',@i)">@statementDetail.Reference</textarea>
                                </td>
                                <td style="width: 15%; text-align: center;">
                                    <div style="width: 90%; height: 20px; border: 1px solid #CECCCD; margin: -20px 0px 0px 10px;">
                                        <label style="font-weight: bold;">@statementDetail.Amount
                                        </label>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                        <tr style="width: 100%;">
                            <td style=" text-align: center;border-right: 0px solid black !important;">
                                New Item
                            </td>
                            <td style="width: 55%;height: 30px; text-align:left; border-left:  0px solid black!important;">
                                New Discount
                            </td>
                            <td style="width: 20%; text-align: center;">
                               TOTAL AMOUNT
                            </td>
                            <td style="width: 15%; text-align: center; font-weight: bold;">
                                EUR 50,566.85
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table style="width: 100%; border-collapse: collapse; border: 0px !important;">
                    <tr style="width: 100%;">
                        <td colspan="2" style="border: 0px !important; text-align: left; font-weight: bold;
                            padding-left: 5px;">
                            <div style="width: 70%; display: inline-block; text-align: left;">
                                For Telegraphic Transfer Payments:
                            </div>
                            <div style="width: 30%; display: inline-block; text-align: right;">
                                Note</div>
                        </td>
                        <td rowspan="7" style="border: 0px !important;">
                            <div>
                                <textarea rows="7" cols="105" name="styled-textarea" id="noteId"></textarea>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Beneficiary
                        </td>
                        <td class="noneBorder paddingLeft height20 ">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Account No
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            IBAN
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Beneficiary Bank
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Swift Code
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 10%;" class="noneBorder paddingLeft height20">
                            Correspondent
                        </td>
                        <td style="width: 35%;" class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                        <td style="width: 55%;" rowspan="3" class="noneBorder  height20">
                            <div>
                                <input id="saveID" name="saveID" class="ui-button ui-widget ui-state-default ui-corner-all"  type="button" value="SAVE" />
                                <input id="reviewID" name="reviewID" class="ui-button ui-widget ui-state-default ui-corner-all"  type="button" value="REVIEW" />
                                <input id="pdfID" name="pdfID" class="ui-button ui-widget ui-state-default ui-corner-all"  type="button" value="EXPORT PDF" />
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Swift Code
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Account No
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp; <div class="label">&nbsp;</div> 
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
<script type="text/javascript">
    function setbg(color, id) {
        document.getElementById("styled_" + id).style.background = color
    }
</script>
