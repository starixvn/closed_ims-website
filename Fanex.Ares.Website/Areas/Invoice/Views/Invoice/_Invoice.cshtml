@using Fanex.Ares.Invoice.Models.Invoice;
@using Fanex.Ares.Core.Extensions;
@using DNAide.Core;
@using Fanex.Common;
@{
    InvoiceModel model = new InvoiceModel();
    model = Model;
    int index = 0;
    double totalAmount = 0;
    string descript = "Software & Data Licensing & Data transmission fees for ";
}
<div class="wrapper">
    <div class="content" style="width: 90%;">
        <div class="boundary">
            <table id="header">
                <tr>
                    <td>
                        <table style="width: 100%;">
                            <thead>
                                <tr>
                                    <th style="width: 10%; text-align: center;">
                                        ITEM
                                    </th>
                                    <th style="width: 55%; text-align: center; height: 34px;">
                                        DESCRIPTION
                                    </th>
                                    <th style="width: 20%; text-align: center;">
                                        REFERENCE
                                    </th>
                                    <th style="width: 15%; text-align: center;">
                                        AMOUNT
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
        <div id="box" class="box">
            <table id="tbl-content">
                <tr>
                    <td>
                        <table id="invoiceTbl" style="width: 100%;">
                            <tbody>
                                @for (int i = 0; i < model.StatementList.Count; i++)
                                {
                                    Statement state = model.StatementList[i];
                                    for (int j = 0; j < state.StatementDetailList.Count; j++)
                                    {
                                        StatementDetail detail = state.StatementDetailList[j];
                                        totalAmount += detail.Amount;
                                        string fakeCssTd =  (j == 0 ? string.Empty :  "fakeCssTd");
                                    <tr style="width: 100%; text-align: center;">
                                        @if (j == 0)
                                        {
                                            <td  rowspan="@state.StatementDetailList.Count" style="width: 10%; vertical-align:top;padding-top: 20px; ">
                                                <div style="font-size: 20px; display: inline-block;">
                                                    @(i + 1)</div>
                                                <div  title="View detail" style="display: inline-block;"  class="viewdetail" onclick="invoiceApp.viewDetail('@state.FromDate', '@state.ToDate')">
                                                </div>
                                            </td>
                                        }
                                        <td  class="@fakeCssTd"style="width: 55%; text-align: center; height: 60px; ">
                                            <textarea  rows="2" cols="106" name="styled-textarea" id="orgItem_des_@index"  onfocus="invoiceApp.helper.onFocusInput(this)" onblur="invoiceApp.helper.onBlurInput(this)" onchange=" invoiceApp.AllowUpdateNewInfo();">
                                    @if (j == 0)
                                    {
                                       @descript @detail.Description
                                    }
                                    else
                                    {
                                        @detail.Description
                                       
                                    }</textarea>
                                        </td>
                                        <td class="@fakeCssTd" style="width: 20%; text-align: center;">
                                            <textarea  rows="2" cols="33" name="styled-textarea" id="orgItem_ref_@index"  onfocus="invoiceApp.helper.onFocusInput(this)" onblur="invoiceApp.helper.onBlurInput(this)"  onchange=" invoiceApp.AllowUpdateNewInfo();">@detail.Reference</textarea>
                                        </td>
                                        <td class="@fakeCssTd" style="width: 15%; text-align: right; vertical-align: middle; font-weight: bold;
                                            padding-right: 10px;">
                                            @MvcHtmlString.Create(detail.Amount == 0 && detail.DiscountItem ? "(nil)" : NumberExtensions.NegativeFormat(detail.Amount))
                                        </td>
                                    </tr>
                                    index++;
                                    }
                                }
                                <tr class="total" style="width: 100%;">
                                    <td style="text-align: center; border-right: 0px solid black !important; padding-left: 25px;">
                                        <div title="Add new item" style="display: inline-block;" class="newitem" onclick="invoiceApp.addItem(false)">
                                        </div>
                                        &nbsp;&nbsp;
                                        <div title="Add new discount" style="display: inline-block;" class="discount" onclick="invoiceApp.addItem(true)">
                                        </div>
                                    </td>
                                    <td style="width: 55%; height: 30px;">
                                    </td>
                                    <td style="width: 20%; text-align: right; font-weight: bold; ">
                                        TOTAL AMOUNT
                                    </td>
                                    <td style="width: 15%; text-align: center; font-weight: bold;">
                                        <div style="width: 90%; height: 20px; margin: 0px 5px 0px 10px; text-align: right;">
                                            <label id="totalAmount" style="font-weight: bold;">
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table style="width: 100%; border-collapse: collapse; border: 0px !important;">
                            <tr>
                                <td colspan="4" style="height: 15px;">
                                </td>
                            </tr>
                            <tr style="width: 100%;">
                                <td colspan="2" style="border: 0px !important; text-align: left; font-weight: bold;
                                    padding-left: 10px;">
                                    <div style="width: 70%; display: inline-block; text-align: left;">
                                        For Telegraphic Transfer Payments:
                                        <br />
                                    </div>
                                    <div style="width: 27%; display: inline-block; text-align: right;">
                                        Note</div>
                                </td>
                                <td rowspan="7" style="border: 0px !important; vertical-align: top">
                                    <div>
                                        <textarea maxlength="300" rows="5" cols="85" name="styled-textarea" id="noteId" onfocus="invoiceHelper.onFocusInput(this)"
                                            onblur="invoiceApp.helper.onBlurInput(this)" onchange=" invoiceApp.helper.allowUpdateNewInfo();"></textarea>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                    <br />
                                    Beneficiary
                                </td>
                                <td class="noneBorder paddingLeft height20 ">
                                    <br />
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divBeneficiary">
                                        &nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                    Account No
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divAccountNo">
                                        &nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                    IBAN
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divIBAN">
                                        &nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                    Beneficiary Bank
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divBeneficiaryBank">
                                        &nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                    Swift Code
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divSwiftCode">
                                        &nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                </td>
                            </tr>
                            <tr>
                                <td style="width: 10%;" class="noneBorder paddingLeft height20">
                                    Correspondent
                                </td>
                                <td style="width: 45%;" class="noneBorder paddingLeft height20">
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divCorrespondent">
                                        &nbsp;</div>
                                </td>
                                <td style="width: 45%;" rowspan="3" class="noneBorder  height20">
                                <div style="display:inline-block; float:left; font-weight: bold;">
                                        <input type="checkbox" id="chkSign"> with signature
                                </div>
                                    <div style="display:inline-block;">
                                        <input id="saveID" name="saveID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                            type="button" value="SAVE" />&nbsp;&nbsp;&nbsp;
                                        <input id="reviewID" name="reviewID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                            type="button" value="PREVIEW" onclick="invoiceApp.previewInvoice()" />&nbsp;&nbsp;&nbsp;
                                        <input id="pdfID" name="pdfID" class="ui-button ui-widget ui-state-default ui-corner-all ui-state-disabled"
                                            type="button" value="EXPORT TO PDF" onclick="ExportPDF()" />
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                    Swift Code
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divCorrespondentSwiftCode">
                                        &nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                    Account No
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                    :&nbsp;&nbsp;&nbsp;
                                    <div class="label" id="divCorrespondentAccNo">
                                        &nbsp;</div>
                                </td>
                            </tr>
                            <tr>
                                <td class="noneBorder paddingLeft height20">
                                </td>
                                <td class="noneBorder paddingLeft height20">
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
        <!--end #box-->
    </div>
    <!--end #content-->
</div>
<!--end #wrapper-->
<div id="dialogConfirm" style="display: none;">
    <table border="0px" id="tblconfirm">
    </table>
</div>
<script src="Scripts/angular.min.js" type="text/javascript"></script>
<script type="text/javascript">
    var _totalAmount = @totalAmount; 
    
    $("#totalAmount").empty().html(invoiceApp.Currency.CurrencyName + ' ' +  invoiceApp.helper.negativeFormat(_totalAmount));
     invoiceApp.TotalAmount = _totalAmount;
    $('#saveID').button();
   
    $('#saveID').click(function () { if (!$(this).hasClass('ui-state-disabled')) invoiceApp.saveInvoice(); });
    var invoiceInfo = '@Json.Encode(Model)';
    invoiceInfo = invoiceInfo.replace(/&quot;/g, '"').replace(/&amp;/g, '&');
    invoiceInfoModel = jQuery.parseJSON(invoiceInfo);
    var OrgInvoiceInfoModel =[];
     OrgInvoiceInfoModel = $.extend(true, {}, invoiceInfoModel);

    var divContentHeight = $(window).height() - 200;
    $('#divContent').height(divContentHeight);

    if (invoiceInfoModel.StatementList.length == 0) {
        $('#saveID').addClass('ui-state-disabled').attr('disabled', 'disabled');
        $('#reviewID').addClass('ui-state-disabled').attr('disabled', 'disabled');
    }
    else {
        $('#divBeneficiary').html(invoiceApp.Operator.Benificiary + "&nbsp;&nbsp;&nbsp;");
        $('#divBeneficiaryBank').html(invoiceApp.Operator.BenificiaryBank + "&nbsp;&nbsp;&nbsp;");
        $('#divAccountNo').html(invoiceApp.Operator.AccountNumber + "&nbsp;&nbsp;&nbsp;");
        $('#divIBAN').html(invoiceApp.Operator.IBAN + "&nbsp;&nbsp;&nbsp;");
        $('#divSwiftCode').html(invoiceApp.Operator.SwiftCode + "&nbsp;&nbsp;&nbsp;");
        $('#divCorrespondent').html(invoiceApp.Operator.CorrespondentBank + "&nbsp;&nbsp;&nbsp;");
        $('#divCorrespondentSwiftCode').html(invoiceApp.Operator.CorrespondentSwiftCode + "&nbsp;&nbsp;&nbsp;");
        $('#divCorrespondentAccNo').html(invoiceApp.Operator.CorrespondentAccNo + "&nbsp;&nbsp;&nbsp;");
    }


function ExportPDF()
{
    $('#tblconfirm').empty().append("<tr><td class='popupTd'>Do you want to export document with signature?</td></tr>");
            $("#tblconfirm").dialog({
                title: "Export PDF",
                autoOpen: false,
                height: 130,
                width: 360,
                resizable: false,
                modal: true,
                buttons: {
                    Yes: function () {
                        link = '@Url.Action("ExportDocument", "Invoice", new { isSignature = true })';
                        location.href = link;
                         $(this).dialog("close");
                    },
                    No: 
                     function () {
                       link = '@Url.Action("ExportDocument", "Invoice", new { isSignature = false })';
                        location.href = link;
                         $(this).dialog("close");
                    }
                },
                close: function (event, ui) {
                }
            });
            $('a.ui-dialog-titlebar-close').show();
            $("#tblconfirm").dialog("open");
}

$("#noteId").bind('input propertychange', function () {
    var maxLength = $('#noteId').attr('maxlength');
    if ($(this).val().length > maxLength) {
        $(this).val($(this).val().substring(0, maxLength));
    }
});
</script>
