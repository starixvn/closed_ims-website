@using Fanex.Ares.Invoice.Models.Invoice;
@{
    InvoiceModel model = new InvoiceModel();
    model = Model;
    int index = 0;
    double totalAmount = 0;
    
}
<style type="text/css">
    table, th, td
    {
        background: #EDECEA;
        border: 1px solid #CECCCD;
        text-align: center;
        vertical-align: middle;
    }
    
    
    th
    {
        background-color: #E9E480;
        color: black;
        font-weight: bold;
    }
    table
    {
        border-collapse: collapse;
    }
    
    textarea#styled
    {
        width: 95%;
        height: 40px;
        border: 1px solid #cccccc;
        padding: 5px;
        font-family: Tahoma, sans-serif;
        background-image: url(bg.gif);
        background-position: bottom right;
        background-repeat: no-repeat;
    }
    
    .div-content
{
    clear:both; 
    width: 1260px; 
    margin:40px 0 0 10px;
    padding: 2px;
}
    .noneBorder
    {
        border: 0px !important;
    }
    
    .paddingLeft
    {
        text-align: left;
        padding-left: 5px;
    }
    
    .height20
    {
        height: 20px;
    }
    
    .label
    {
        width: 75%;
        font-weight: bold;
        background-color: #c3c2c2 !important;
        display: inline-block;
        
    }
</style>
<div class="div-content" style="overflow: auto; width: 100%; padding-top: 20px; margin: 0px !important;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style='border-collapse: collapse;'>
        <tr>
            <td>
                <table style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="height: 34px;">
                                ITEM
                            </th>
                            <th>
                                DESCRIPTION
                            </th>
                            <th>
                                REFERENCE
                            </th>
                            <th>
                                AMOUNT
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < model.StatementList.Count; i++)
                        {
                            Statement state = model.StatementList[i];

                            for (int j = 0; j < state.StatementDetailList.Count; j++)
                            {
                                StatementDetail detail = state.StatementDetailList[j];
                                totalAmount += detail.Amount;
                            <tr style="width: 100%; text-align: center;">
                                @if (j == 0)
                                {
                                    <td rowspan="@state.StatementDetailList.Count" style="width: 10%; ">
                                        @(i + 1)
                                        <br /><br /><br /><br /><br />
                                          <a style="text-decoration:underline;cursor: pointer; font-style:italic;">Detail</a>
                                    </td>
                                }
                                <td style="width: 55%; text-align: center; height: 60px;">
                                    <textarea rows="2" cols="106" name="styled-textarea" id="styled_@index" onfocus="setbg('#e5fff3',@index);" onblur="setbg('white',@index)">@detail.Description</textarea>
                                </td>
                                @{
                                index++;
                                }
                                <td style="width: 20%; text-align: center;">
                                    <textarea rows="2" cols="33" name="styled-textarea" id="styled_@index" onfocus="setbg('#e5fff3',@index);" onblur="setbg('white',@index)">@detail.Reference</textarea>
                                </td>
                                <td style="width: 15%; text-align: center;">
                                    <div style="width: 90%; height: 20px; border: 1px solid #CECCCD; margin: -20px 5px 0px 10px;text-align: right;">
                                        <label style="font-weight: bold; ">@detail.Amount
                                        </label>
                                    </div>
                                </td>
                            </tr>
                                index++;
                            }
                        }
                        <tr style="width: 100%;">
                            <td style="text-align: center; border-right: 0px solid black !important;">
                                <a style="text-decoration:underline; cursor: pointer; font-style:italic;">+New Item</a>
                            </td>
                            <td style="width: 55%; height: 30px; text-align: left; border-left: 0px solid black!important;">
                                <a style="text-decoration:underline;cursor: pointer; font-style:italic;">+New Discount</a>
                            </td>
                            <td style="width: 20%; text-align: center;">
                                TOTAL AMOUNT
                            </td>
                            <td style="width: 15%; text-align: center; font-weight: bold;">
                                EUR @totalAmount
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table style="width: 100%; border-collapse: collapse; border: 0px !important;">
                <tr>
                    <td colspan="3" class="noneBorder ">
                    
                     <div style="width:95%; height:5px; background-color: White !important; margin:5px;"> </div>
                    </td>
                </tr>
                    <tr style="width: 100%;">
                        <td colspan="2" style="border: 0px !important; text-align: left; font-weight: bold;
                            padding-left: 5px;">
                            <div style="width: 70%; display: inline-block; text-align: left;">
                                For Telegraphic Transfer Payments:
                            </div>
                            <div style="width: 27%; display: inline-block; text-align: right;">
                                Note</div>
                        </td>
                        <td rowspan="7" style="border: 0px !important; vertical-align:top">
                            <div>
                                <textarea rows="5" cols="90" name="styled-textarea" id="noteId"></textarea>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Beneficiary
                        </td>
                        <td class="noneBorder paddingLeft height20 ">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Account No
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            IBAN
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Beneficiary Bank
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Swift Code
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 10%;" class="noneBorder paddingLeft height20">
                            Correspondent
                        </td>
                        <td style="width: 45%;" class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                        <td style="width: 45%;" rowspan="3" class="noneBorder  height20">
                            <div>
                                <input id="saveID" name="saveID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                    type="button" value="SAVE" />&nbsp;&nbsp;&nbsp;
                                <input id="reviewID" name="reviewID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                    type="button" value="REVIEW"  onClick="window.open('@Url.Action("PrintScreen", "Invoice", null)', 'mywindow','width=1260px,height=900px,scrollbars=yes')")"/>&nbsp;&nbsp;&nbsp;
                                <input id="pdfID" name="pdfID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                    type="button" value="EXPORT PDF" onClick="location.href='@Url.Action("ExportDocument", "Invoice", new { documentType = Fanex.Ares.Core.Extensions.WorkBookExtension.DocumentType.Pdf })'"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Swift Code
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Account No
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
<script type="text/javascript">
    function setbg(color, id) {
        document.getElementById("styled_" + id).style.background = color
    }
</script>
