@using Fanex.Ares.Invoice.Models.Invoice;
@using Fanex.Ares.Core.Extensions;
@using DNAide.Core;
@using Fanex.Ares.Invoice.Models.Invoice;
@using Fanex.Common;
@{
    InvoiceModel model = new InvoiceModel();
    model = Model;
    int index = 0;
    double totalAmount = 0;
    string descript = "Software & Data Licensing & Data transmission fees for ";
}
@functions {
    public string NegativeFormat(double input)
    {
        string output = string.Empty;

        output = input >= 0 ? "<span style=\"font-weight: bold;\">" + Converter.To<string>(input.Format(2)) + "</span>" : "<span style=\"color: red;font-weight: bold;\">(" + Converter.To<string>((input * -1).Format(2)) + ")</span>";

        return output;
    }
}
<div id="divContent" class="div-content" style="overflow: auto; width: 100%;  margin: 0px !important;">
    <table id="invoiceTbl" border="0" cellpadding="0" cellspacing="0" width="100%" style='border-collapse: collapse;'>
        <tr>
            <td>
                <table style="width: 100%;">
                    <thead>
                        <tr>
                            <th style="height: 34px;">
                                ITEM
                            </th>
                            <th>
                                DESCRIPTION
                            </th>
                            <th>
                                REFERENCE
                            </th>
                            <th>
                                AMOUNT
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < model.StatementList.Count; i++)
                        {
                            Statement state = model.StatementList[i];

                            for (int j = 0; j < state.StatementDetailList.Count; j++)
                            {
                                StatementDetail detail = state.StatementDetailList[j];
                                totalAmount += detail.Amount;
                            <tr style="width: 100%; text-align: center;">
                                @if (j == 0)
                                {
                                    <td rowspan="@state.StatementDetailList.Count" style="width: 10%; ">
                                        @(i + 1)
                                        <br />
                                        <br />
                                        <br />
                                        <br />
                                        <br />
                                        <a onclick="Detail('@state.FromDate', '@state.ToDate')" style="text-decoration: underline; cursor: pointer; font-style: italic;">
                                            Detail</a>
                                    </td>
                                }
                                <td style="width: 55%; text-align: center; height: 60px;">
                                    <textarea  rows="2" cols="106" name="styled-textarea" id="orgItem_des_@index" onfocus="setbg('#e5fff3','orgItem_des_@index');" onblur="setbg('white','orgItem_des_@index');" onchange=" CreatingInvoice.AllowUpdateNewInfo();">
                                    @if (j == 0)
                                    {
                                       @descript @detail.Description
                                    }
                                    else
                                    {
                                    @detail.Description
                                    }</textarea>
                                </td>
                                <td style="width: 20%; text-align: center;">
                                    <textarea  rows="2" cols="33" name="styled-textarea" id="orgItem_ref_@index" onfocus="setbg('#e5fff3','orgItem_ref_@index');" onblur="setbg('white','orgItem_ref_@index')"  onchange=" CreatingInvoice.AllowUpdateNewInfo();">@detail.Reference</textarea>
                                </td>
                                <td style="width: 15%; text-align: center;">
                                    <div style="width: 90%; height: 20px; border: 1px solid #CECCCD; margin: -20px 5px 0px 10px;
                                        text-align: right;font-weight: bold;">
                                        @MvcHtmlString.Create(detail.Amount == 0 && detail.DiscountItem ? "(nil)" : NegativeFormat(detail.Amount))
                                    </div>
                                </td>
                            </tr>
                                    index++;
                            }
                        }
                        <tr class="total" style="width: 100%;">
                            <td style="text-align: center; border-right: 0px solid black !important;">
                                <a onclick="CreatingInvoice.AddItem(false)" style="text-decoration: underline; cursor: pointer;
                                    font-style: italic;">+New Item</a>
                            </td>
                            <td style="width: 55%; height: 30px; text-align: left; border-left: 0px solid black!important;">
                                <a onclick="CreatingInvoice.AddItem(true)" style="text-decoration: underline; cursor: pointer;
                                    font-style: italic;">+New Discount</a>
                            </td>
                            <td style="width: 20%; text-align: center;">
                                TOTAL AMOUNT
                            </td>
                            <td style="width: 15%; text-align: center; font-weight: bold;">
                                <div style="width: 90%; height: 20px; margin: 0px 5px 0px 10px; text-align: right;">
                                    <label id="totalAmount" style="font-weight: bold;">
                                        
                                    </label>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table style="width: 100%; border-collapse: collapse; border: 0px !important;">
                    <tr>
                        <td colspan="3" class="noneBorder ">
                            <div style="width: 99%; height: 5px; background-color: White !important; margin: 5px;">
                            </div>
                        </td>
                    </tr>
                    <tr style="width: 100%;">
                        <td colspan="2" style="border: 0px !important; text-align: left; font-weight: bold;
                            padding-left: 5px;">
                            <div style="width: 70%; display: inline-block; text-align: left;">
                                For Telegraphic Transfer Payments:
