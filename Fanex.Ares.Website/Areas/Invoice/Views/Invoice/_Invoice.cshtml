                        </td>
                        <td rowspan="7" style="border: 0px !important; vertical-align: top">
                            <div>
                                <textarea maxlength="300" rows="5" cols="90" name="styled-textarea" id="noteId" onfocus="setbg('#e5fff3','noteId');" onblur="setbg('white','noteId')"></textarea>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Beneficiary
                        </td>
                        <td class="noneBorder paddingLeft height20 ">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divBeneficiary">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Account No
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divAccountNo">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            IBAN
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divIBAN">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Beneficiary Bank
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divBeneficiaryBank">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Swift Code
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divSwiftCode">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 10%;" class="noneBorder paddingLeft height20">
                            Correspondent
                        </td>
                        <td style="width: 45%;" class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divCorrespondent">
                                &nbsp;</div>
                        </td>
                        <td style="width: 45%;" rowspan="3" class="noneBorder  height20">
                            <div>
                                <input id="saveID" name="saveID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                    type="button" value="SAVE" />&nbsp;&nbsp;&nbsp; @*<input id="reviewID" name="reviewID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                    type="button" value="REVIEW"  onClick="window.open('@Url.Action("PrintScreen", "Invoice", null)', 'mywindow','width=1260px,height=900px,scrollbars=yes')")"/>&nbsp;&nbsp;&nbsp;*@
                                <input id="reviewID" name="reviewID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                    type="button" value="PREVIEW" onclick="Review()" />&nbsp;&nbsp;&nbsp; @*  <input id="pdfID" name="pdfID" class="ui-button ui-widget ui-state-default ui-corner-all ui-state-disabled" 
                                    type="button" value="EXPORT TO PDF"  onClick="ExportPDF()"/>*@
                                <input id="pdfID" name="pdfID" class="ui-button ui-widget ui-state-default ui-corner-all ui-state-disabled" 
                                    type="button" value="EXPORT PDF" onClick="location.href='@Url.Action("ExportDocument", "Invoice")'"/>
                                @* <input id="pdfID" name="pdfID" type="button" value="pdfID" onclick="ExportPdf()" />
                                <input id="pdfexcel" name="pdfID" class="ui-button ui-widget ui-state-default ui-corner-all"
                                    type="button" value="EXPORT ECXEL" onClick="location.href='@Url.Action("ExportDocument", "Invoice", new { documentType = Fanex.Ares.Core.Extensions.WorkBookExtension.DocumentType.Xlsx })'"/>*@
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Swift Code
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divCorrespondentSwiftCode">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                            Account No
                        </td>
                        <td class="noneBorder paddingLeft height20">
                            :&nbsp;&nbsp;&nbsp;
                            <div class="label" id="divCorrespondentAccNo">
                                &nbsp;</div>
                        </td>
                    </tr>
                    <tr>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                        <td class="noneBorder paddingLeft height20">
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="333"></div>
<script type="text/javascript">
    function setbg(color, id) {
        document.getElementById(id).style.background = color
    }

    var _totalAmount = @totalAmount; 
    $("#totalAmount").empty().html(CreatingInvoice.Currency.CurrencyName + ' ' +  NegativeFormat(_totalAmount));
    $('#saveID').button();
   
    $('#saveID').click(function () { if (!$(this).hasClass('ui-state-disabled')) CreatingInvoice.SaveInvoice(); });
    var invoiceInfo = '@Json.Encode(Model)';
    invoiceInfo = invoiceInfo.replace(/&quot;/g, '"').replace(/&amp;/g, '&');
    invoiceInfoModel = jQuery.parseJSON(invoiceInfo);
    var OrgInvoiceInfoModel =[];
     OrgInvoiceInfoModel = $.extend(true, {}, invoiceInfoModel);

    var divContentHeight = $(window).height() - 200;
    $('#divContent').height(divContentHeight);

    if (invoiceInfoModel.StatementList.length == 0) {
        $('#saveID').addClass('ui-state-disabled').attr('disabled', 'disabled');
//        $('#reviewID').addClass('ui-state-disabled');
    }
    else {

        $('#divBeneficiary').html(CreatingInvoice.Operator.Benificiary + "&nbsp;&nbsp;&nbsp;");
        $('#divBeneficiaryBank').html(CreatingInvoice.Operator.BenificiaryBank + "&nbsp;&nbsp;&nbsp;");
        $('#divAccountNo').html(CreatingInvoice.Operator.AccountNumber + "&nbsp;&nbsp;&nbsp;");
        $('#divIBAN').html(CreatingInvoice.Operator.IBAN + "&nbsp;&nbsp;&nbsp;");
        $('#divSwiftCode').html(CreatingInvoice.Operator.SwiftCode + "&nbsp;&nbsp;&nbsp;");
        $('#divCorrespondent').html(CreatingInvoice.Operator.CorrespondentBank + "&nbsp;&nbsp;&nbsp;");
        $('#divCorrespondentSwiftCode').html(CreatingInvoice.Operator.CorrespondentSwiftCode + "&nbsp;&nbsp;&nbsp;");
        $('#divCorrespondentAccNo').html(CreatingInvoice.Operator.CorrespondentAccNo + "&nbsp;&nbsp;&nbsp;");
    }

function Review() {
  NapAres.disableInput();
    CreatingInvoice.UpdateItem();
    invoiceInfoModel.Operator = CreatingInvoice.Operator;
    invoiceInfoModel.Licensee = CreatingInvoice.Licensee;
    invoiceInfoModel.FromDate = CreatingInvoice.FromDate;
    invoiceInfoModel.ToDate = CreatingInvoice.ToDate;
    invoiceInfoModel.DueDate = CreatingInvoice.DueDate;
    invoiceInfoModel.Currency = CreatingInvoice.Currency.CurrencyID;
    invoiceInfoModel.CurrencyName = CreatingInvoice.Currency.CurrencyName;
    invoiceInfoModel.InvoiceType = CreatingInvoice.InvoiceType;
    invoiceInfoModel.Product = CreatingInvoice.Products;
    invoiceInfoModel.ProductsName = CreatingInvoice.ProductsName;
    invoiceInfoModel.InvoiceNo = CreatingInvoice.InvoiceNo;
    invoiceInfoModel.InvoiceName = CreatingInvoice.InvoiceName;
    $.ajax({
        url: domain + "Invoice/Invoice/PrintScreen",
        data: '{"invoice":' + JSON.stringify(invoiceInfoModel) + '}',
        contentType: 'application/json',
        type: "POST",
        success: function (data, textStatus, jqXHR) {
            if (data) {
                var win = window.open((domain + 'Invoice/Invoice/ReviewInvoice'), ('invoice' + new Date().getMilliseconds()));
              
                if($.browser.msie){
                    win.load = new function(){
                        win.document.write(data);
                        win.document.title = CreatingInvoice.InvoiceName;
                    }
                }
                else{
                    $(win).load(function(){ 
                        win.document.write(data);
                        win.document.title = CreatingInvoice.InvoiceName;
                    });
                }
            }
        },
        error: function(){
            NapAres.Helper.showMsgBox({ ErrorCode: 1, ErrorMsg: 'Fail' });
            setTimeout('NapAres.Helper.hideMsgBox()', CreatingInvoice.messageTimeOut);
             NapAres.enableInput();
        }
    });
     NapAres.enableInput();
    invoiceInfoModel = [];
    invoiceInfoModel = $.extend(true, {}, OrgInvoiceInfoModel);
}


function Detail(fromDate, toDate) {
 NapAres.disableInput();
    CreatingInvoice.UpdateItem();
    invoiceInfoModel.Operator = CreatingInvoice.Operator;
    invoiceInfoModel.Licensee = CreatingInvoice.Licensee;
    invoiceInfoModel.FromDate = fromDate;
    invoiceInfoModel.ToDate = toDate;
    invoiceInfoModel.DueDate = CreatingInvoice.DueDate;
    invoiceInfoModel.Currency = CreatingInvoice.Currency.CurrencyID;
    invoiceInfoModel.CurrencyName = CreatingInvoice.Currency.CurrencyName;
    invoiceInfoModel.InvoiceType = CreatingInvoice.InvoiceType;
    invoiceInfoModel.Product = CreatingInvoice.Products;
    invoiceInfoModel.ProductsName = CreatingInvoice.ProductsName;
    invoiceInfoModel.InvoiceNo = CreatingInvoice.InvoiceNo;
    invoiceInfoModel.InvoiceName = CreatingInvoice.InvoiceName;
    $.ajax({
        url: domain + "Invoice/Invoice/Detail",
        data: '{"invoice":' + JSON.stringify(invoiceInfoModel) + '}',
        contentType: 'application/json',
        type: "POST",
        success: function (data, textStatus, jqXHR) {
            if (data) {
                var win = window.open((domain + 'Invoice/Invoice/ReviewInvoice'), ('invoice' + new Date().getMilliseconds()));
	              
                if($.browser.msie){
                    win.load = new function(){
                        win.document.write(data);
                        win.document.title = CreatingInvoice.InvoiceName;
                    }
                }
                else{
                    $(win).load(function(){ 
                        win.document.write(data);
                        win.document.title = CreatingInvoice.InvoiceName;
                    });
                }
            }
        },
        error: function(){
            NapAres.Helper.showMsgBox({ ErrorCode: 1, ErrorMsg: 'Fail' });
            setTimeout('NapAres.Helper.hideMsgBox()', CreatingInvoice.messageTimeOut);
             NapAres.enableInput();
        }
    });
     NapAres.enableInput();
}

</script>
