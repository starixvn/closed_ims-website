@using Fanex.Ares.Core.Resources;
@using Fanex.Ares.Core.Web;
@using Fanex.Ares.Core.Services.Impl;
@using Fanex.Ares.Invoice.Criteria.Invoice;
@using Fanex.Ares.Core.Extensions;
@using Fanex.Ares.Core.Models;
@using Fanex.Ares.Invoice.Models.Invoice;
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : "Create Invoice";
    var invoiceModel = new InvoiceModel();
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/Scripts/_Libs/MultipleSelect/style", "~/Scripts/_Libs/DatePicker/style", "~/Scripts/_Libs/MonthPicker/style")
    <link rel="stylesheet" type="text/css" href="~/scripts/_libs/MonthPicker/monPickr-0.0.3-custom.less?ver=@DateTime.Now.ToString()" />
    <link rel="stylesheet" type="text/css" href="~/Scripts/_Libs/Tooltip/tipsy.css" />
    <link href="~/Scripts/_Libs/MultipleSelect/jquery.multiselect.css" rel="stylesheet"
        type="text/css" />
}
@section Headline {
    <div class="title" style="width: width:98%;">
        <div>
            <span>Invoice System / </span><span class="curr">@ViewBag.Title </span>
        </div>
    </div>
}
<div id="filter-bar" ng-app='Invoice' ng-controller="filterController" id="ng-app">
    <span id="notemessage" class="note-info-message" title='For data accuracy, the system allows you to generate the billing report 5 days after month-end'>
    </span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4  align-right">
                    Party/Operator
                </div>
                <div class="edit-field col_8">
                    <select ng-change="getLicensees()" ng-model="operator" ng-options="value.PartyFullName for value in operators"
                        style="width: 201px;">
                        <option value="">Please Select One!</option>
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    @Labels.Licensee
                </div>
                <div class="edit-field col_5">
                    <select ng-change="getInvoiceType()" ng-model="licensee" ng-options="value.LicenseeName for value in licensees"
                        style="width: 135px;">
                        <option value="">Please Select One!</option>
                    </select>
                </div>
                <div id="fromTopickerplugin">
                </div>
                <div id="duteDatepickerplugin">
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_4 align-right">
                    Invoice Type
                </div>
                <div id="divInvoiceType" class="edit-field col_8">
                    <select id="ddlInvoiceType">
                    </select>
                </div>
                <div class="lbl-field col_3 align-right">
                    Invoice No.
                </div>
                <div class="edit-field col_5 align-left">
                    <input style="width: 133px" type="text" ng-model="invoiceNo" />
                </div>
                <div class="lbl-field col_3 align-right">
                    Currency
                </div>
                <div id="divCurrencyID" class="edit-field col_6">
                    <select ng-disabled="baseCurrencies.length == 1 || baseCurrencies.length == 0" ng-model="baseCurrency"
                        ng-options="currency.Text for currency in baseCurrencies" class="col_5">
                    </select>
                </div>
                <div class="submit col_4">
                    <input ng-click="submit()" id="btnGenerate" name="btnGenerate" type="button" value="GENERATE" />
                </div>
                <div class="submit col_6  align-center">
                    <input onClick="location.href='@Url.Action("Index", "Invoice")'" id="btnNewInvoice" class="ui-button ui-widget ui-state-default ui-corner-all"  name="btnNewInvoice" type="button" value="NEW INVOICE" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="InformationMssg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="grid-title" style="clear: both; display: none;">
    <div class="grid-title-label">
        <span id=""></span>
    </div>
</div>
<div style="height: 100px;">
</div>
<div id="parentContainer" class="content-grid" style="width: 97%;">
</div>
<div id="ims-dialog-message">
</div>
@section scripts
{
    <script type="text/javascript">
        var operatorList = '@Json.Encode(ViewBag.ListOperator)';
        operatorList = operatorList.replace(/&quot;/g, '"').replace(/&amp;/g, '&');
        var operatorListModel = jQuery.parseJSON(operatorList);

        var invoiceModel = '@Json.Encode(invoiceModel)';
        invoiceModel = invoiceModel.replace(/&quot;/g, '"').replace(/&amp;/g, '&');
        var invoiceInfoModel = jQuery.parseJSON(invoiceModel);
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var _today = '@DateTime.Today.ToShortDateString()';

        var minDate = '@(new DateTime(2013, 1, 1).ToShortDateString())';
        var maxDate = '@(DateTime.Today.AddDays(-5).ToShortDateString())';
        var selectDueDate = '@string.Format("{0}/{1}/{2}", DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month))';
        var notemessage = '@Html.Raw(LicenseeResource.LicenseeSettlementNoteMessage)';
    </script>
}
@section Foot {
    @Scripts.Render("~/Scripts/_Libs/multiselect", "~/Scripts/_Libs/nexDatePicker", "~/Scripts/_Libs/monPickr")
    <script type="text/javascript" src="~/scripts/_libs/tooltip/jquery.tipsy.js"></script>
    <script src="~/Scripts/_Libs/MultipleSelect/jquery.multiselect.js" type="text/javascript"></script>
    <script src="~/Scripts/_Libs/MultipleSelect/jquery.multiradioselect.nlevel_new.js"
        type="text/javascript"></script>
    <script type="text/javascript" src="~/Areas/Invoice/Views/Invoice/Scripts/angular.min.js"></script>
    <script type="text/javascript" src="~/Areas/Invoice/Views/Invoice/Scripts/inovice.angular.js"></script>
    <script type="text/javascript" src="~/Areas/Invoice/Views/Invoice/Scripts/invoice.helper.js"></script>
    <script type="text/javascript" src="~/Areas/Invoice/Views/Invoice/Scripts/invoice.filter.js"></script>
    <script src="~/Scripts/_Libs/FormatLibs/NumberFormat/numeral.js" type="text/javascript"></script>
    <script src="~/Scripts/_Libs/Utils/jquery.numeric.js" type="text/javascript"></script>
}
