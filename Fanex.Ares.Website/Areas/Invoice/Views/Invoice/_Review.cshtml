@{
    
    int index = 1;
}
@foreach (string temp in Model.HTMLReportList)
{
    @MvcHtmlString.Create(temp);
                               if (index < Model.HTMLReportList.Count)
                               {                   
    <div style="width: 100%; height: 10px; background: #565656;">
    </div>
                               }
    index++;
}
