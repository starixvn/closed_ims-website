@using Fanex.Ares.Core.Extensions;
@using DNAide.Core;
@using Fanex.Ares.Invoice.Models.Invoice;
@{
    var isCheckMappingDomail = ViewBag.isCheckMappingDomail;
    var domain = HtmlHelperExtensions.GetFullDomainURL(isCheckMappingDomail);
    InvoiceModel invoiceModel = Model;
    double totalAmount = 0;
}
<div class="div-content invoice-table">
    <table class="table-content" cellpadding="2" cellspacing="0">
        <tr>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="7">
                <img alt="" style="height: 100px;" class="invoice-image" src="@Url.Content(domain + "/Content/Invoice/Images/Boping-logo.png")"/>
            </td>
            <td colspan="8" class="invoice-header">
                <br />
                <br />
                <br />
                @invoiceModel.Operator.To1
            </td>
            <td colspan="1">
            </td>
        </tr>
        <tr>
            <td colspan="7" class="invoice-title">
                &nbsp;INVOICE
            </td>
            <td colspan="9">
            </td>
        </tr>
        <tr>
            <td colspan="10">
            </td>
            <td colspan="6">
            </td>
        </tr>
        <tr>
            <td colspan="10" rowspan="4" class="border-all vertical-align-middle">
                <br />
                <span class="bold-red">TO: @invoiceModel.Licensee.CompanyName.ToUpper()</span>
                <br />
                <br />
                <span style="text-align: left;">@invoiceModel.Licensee.To1</span>
                <br />
                <br />
                <span>ATTN: @invoiceModel.Licensee.AttnName</span>
                <br />
            </td>
            <td colspan="3" class="vertical-align-middle">
                &nbsp;&nbsp;&nbsp;INVOICE NUMBER
            </td>
            <td class="vertical-align-middle">
                :
            </td>
            <td colspan="2" class="bold-red col-header">
                @invoiceModel.InvoiceNo
                <hr />
            </td>
        </tr>
        <tr>
            <td colspan="3" class="vertical-align-middle">
                &nbsp;&nbsp;&nbsp;DATE
            </td>
            <td class="vertical-align-middle">
                :
            </td>
            <td colspan="2" class="bold-red col-header">
                @CastAide.AsDateTime(invoiceModel.ToDate).ToAresDayMonthYear()
                <hr />
            </td>
        </tr>
        <tr>
            <td colspan="3" class="vertical-align-middle">
                &nbsp;&nbsp;&nbsp;DUE DATE
            </td>
            <td class="vertical-align-middle">
                :
            </td>
            <td colspan="2" class="bold-red col-header">
                @CastAide.AsDateTime(invoiceModel.DueDate).ToAresDayMonthYear()
                <hr />
            </td>
        </tr>
        <tr>
            <td colspan="3" class="vertical-align-middle">
                &nbsp;&nbsp;&nbsp;CURRENCY
            </td>
            <td class="vertical-align-middle">
                :
            </td>
            <td colspan="2" class="bold-red col-header">
                @invoiceModel.CurrencyName
                <hr />
            </td>
        </tr>
        <tr>
            <td colspan="10" class="height30">
            </td>
            <td colspan="6">
            </td>
        </tr>
        <tr>
            <td colspan="2" class="border-all col-header height50">
                ITEM
            </td>
            <td colspan="7" class="border-all col-header">
                PARTICULARS
            </td>
            <td colspan="3" class="border-all col-header">
                REF NO
            </td>
            <td colspan="4" class="border-all col-header">
                AMOUNT
            </td>
        </tr>
        @for (var statementIndex = 0; statementIndex < invoiceModel.StatementList.Count; statementIndex++)
        {
            var statement = invoiceModel.StatementList[statementIndex];

            if (statement.StatementID != 100000)
            {
                var descriptionText = string.Empty;
                var refNoText = string.Empty;
                var amountText = string.Empty;
                foreach (var statementDetail in statement.StatementDetailList)
                {
                    var amount = statementDetail.Amount == 0 && statementDetail.DiscountItem ? "(nil)" : NumberExtensions.NegativeFormat(statementDetail.Amount);

                    descriptionText += string.IsNullOrEmpty(statementDetail.Description) ?
                        string.Empty :
                        string.Format("<br/><span>{0}</span><br/>", statementDetail.Description);

                    refNoText += string.IsNullOrEmpty(statementDetail.Reference) ?
                        string.Empty :
                        string.Format("<br/><span>{0}</span><br/>", statementDetail.Reference);

                    amountText += string.Format("<br/>{0}<br/>", amount);

                    totalAmount += statementDetail.Amount;
                }
            <tr>
                <td class="border-all col-header" colspan="2">
                    @(statementIndex + 1)
                </td>
                <td class="border-all col-align-left" colspan="7">
                    @Html.Raw(descriptionText)
                </td>
                <td class="border-all col-align-left" colspan="3">
                    @Html.Raw(refNoText)
                </td>
                <td class="border-all col-align-right" colspan="4">
                    @Html.Raw(amountText)
                </td>
            </tr>
            }
            else
            { 
            <tr>
                <td colspan="16" class="height60">
                </td>
            </tr>
            }
        }
        <tr>
            <td colspan="12" class="border-all vertical-align-middle">
                <table class="currency-table">
                    <tr>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                        <td>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                        </td>
                        <td class="currency-text">
                            USD
                        </td>
                        <td class="currency-mark">
                            @if (invoiceModel.CurrencyName == "USD")
                            {
                                <span>X</span>
                            }
                        </td>
                        <td class="currency-text">
                            EUR
                        </td>
                        <td class="currency-mark">
                            @if (invoiceModel.CurrencyName == "EUR")
                            {
                                <span>X</span>
                            }
                        </td>
                        <td class="currency-text">
                            GBP
                        </td>
                        <td class="currency-mark">
                            @if (invoiceModel.CurrencyName == "GBP")
                            {
                                <span>X</span>
                            }
                        </td>
                    </tr>
                </table>
            </td>
            <td colspan="4" class="border-all vertical-align-middle">
                <span class="col-bold-left">Total Amount: </span><span class="col-total-amount">
                    @MvcHtmlString.Create(NumberExtensions.NegativeFormat(totalAmount))&nbsp; </span>
            </td>
        </tr>
        @if (invoiceModel.IsSignature)
        {
            <tr>
                <td colspan="10" rowspan="3" class="border-all">
                    <table class="table-no-signature">
                        <tr>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="col-align-left bold">
                                For Telegraphic Transfer Payments
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Beneficiary<br />
                                Beneficiary Bank<br />
                                Account Number<br />
                                IBAN<br />
                                Swift Code
                                <br />
                                <br />
                                Correspondent<br />
                                Swift Code<br />
                                <br />
                                <br />
                            </td>
                            <td colspan="4">
                                :&nbsp;&nbsp; @invoiceModel.Operator.Benificiary<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.BenificiaryBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.AccountNumber<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.IBAN<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.SwiftCode
                                <br />
                                <br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentSwiftCode<br />
                                <br />
                                <br />
                            </td>
                        </tr>
                    </table>
                </td>
                <td colspan="6" class="border-all vertical-align-top">
                    <br />
                    Prepared By:
                    <br />
                    <br />
                    <br />
                </td>
            </tr>
            <tr>
                <td colspan="6" class="border-all vertical-align-top">
                    <span class="bold">Accounting Department:</span>
                    <br />
                    <br />
                    Approved By:
                    <br />
                    <br />
                    <br />
                    <br />
                    <br />
                </td>
            </tr>
            <tr>
                <td colspan="6" class="border-all vertical-align-top bold">
                    Authorized Signatory
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="16" class="border-all">
                    <table class="table-no-signature">
                        <tr>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="col-align-left bold">
                                For Telegraphic Transfer Payments
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Beneficiary<br />
                                Beneficiary Bank<br />
                                Account Number<br />
                                IBAN<br />
                                Swift Code
                                <br />
                                <br />
                                Correspondent<br />
                                Swift Code<br />
                                <br />
                                <br />
                            </td>
                            <td colspan="4">
                                :&nbsp;&nbsp; @invoiceModel.Operator.Benificiary<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.BenificiaryBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.AccountNumber<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.IBAN<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.SwiftCode
                                <br />
                                <br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentSwiftCode<br />
                                <br />
                                <br />
                            </td>
                        </tr>
                        <tr>
                            <td>
                            </td>
                            <td colspan="4" class="no-signature">
                                This is a computer generated invoice. No signature is required.
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        }
        <tr>
            <td colspan="16" class="vertical-align-middle height50">
                @MvcHtmlString.Create(invoiceModel.Note)
            </td>
        </tr>
    </table>
</div>
