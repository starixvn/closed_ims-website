@using Fanex.Ares.Core.Extensions;
@using DNAide.Core;
@using Fanex.Ares.Invoice.Models.Invoice;
@{
    var isCheckMappingDomail = ViewBag.isCheckMappingDomail;
    var domain = HtmlHelperExtensions.GetFullDomainURL(isCheckMappingDomail);
    InvoiceModel invoiceModel = Model;
    double totalAmount = 0;
}
<div class="div-content invoice-table">
    <table class="table-content" cellpadding="2" cellspacing="0">
        <tr>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="3">
            </td>
            <td colspan="10">
                <img class="" alt="" src="@Url.Content(domain + "/Content/Invoice/Images/Lupine.jpg")"/>
            </td>
            <td colspan="3">
            </td>
        </tr>
        <tr>
            <td colspan="10">
            </td>
            <td colspan="6">
            </td>
        </tr>
        <tr>
            <td colspan="10" rowspan="3" class="border-all vertical-align-middle">
                <br />
                @invoiceModel.Operator.To1
                <br />
                <br />
            </td>
            <td colspan="2" class="vertical-align-middle">
                &nbsp;&nbsp;&nbsp;DATE
            </td>
            <td colspan="2" class="vertical-align-middle">
                :
            </td>
            <td colspan="2" class="bold-red col-header">
                @CastAide.AsDateTime(invoiceModel.ToDate).ToAresDayMonthYear()
                <hr />
            </td>
        </tr>
        <tr>
            <td colspan="2" class="vertical-align-middle">
                &nbsp;&nbsp;&nbsp;INVOICE NO
            </td>
            <td colspan="2" class="vertical-align-middle">
                :
            </td>
            <td colspan="2" class="bold-red col-header">
                @invoiceModel.InvoiceNo
                <hr />
            </td>
        </tr>
        <tr>
            <td colspan="2" class="vertical-align-middle">
                &nbsp;&nbsp;&nbsp;CURRENCY
            </td>
            <td colspan="2" class="vertical-align-middle">
                :
            </td>
            <td colspan="2" class="bold-red col-header">
                @invoiceModel.CurrencyName
                <hr />
            </td>
        </tr>
        <tr>
            <td colspan="10" class="height30">
            </td>
            <td colspan="6">
            </td>
        </tr>
        <tr>
            <td colspan="11" class="border-all col-header height50">
                DESCRIPTION
            </td>
            <td colspan="5" class="border-all col-header">
                AMOUNT
            </td>
        </tr>
        @for (var statementIndex = 0; statementIndex < invoiceModel.StatementList.Count; statementIndex++)
        {
            var statement = invoiceModel.StatementList[statementIndex];

            if (statement.StatementID != 100000)
            {
                var descriptionText = string.Empty;
                var amountText = string.Empty;
                foreach (var statementDetail in statement.StatementDetailList)
                {
                    var amount = statementDetail.Amount == 0 && statementDetail.DiscountItem ? "(nil)" : NumberExtensions.NegativeFormat(statementDetail.Amount);

                    descriptionText += string.IsNullOrEmpty(statementDetail.Description) ?
                        string.Empty :
                        string.Format("<br/><span>{0}</span><br/>", statementDetail.Description);

                    amountText += string.Format("<br/>{0}<br/>", amount);

                    totalAmount += statementDetail.Amount;
                }
            <tr>
                <td class="border-all col-header col-align-left" colspan="11">
                    @Html.Raw(descriptionText)
                </td>
                <td class="border-all col-align-right" colspan="5">
                    @Html.Raw(amountText)
                </td>
            </tr>
            }
            else
            { 
            <tr>
                <td colspan="16" class="height60">
                </td>
            </tr>
            }
        }
        <tr>
            <td colspan="11">
            </td>
            <td colspan="5" class="border-all vertical-align-middle height30">
                <span class="col-bold-left">Total Amount: </span><span class="col-total-amount">
                    @MvcHtmlString.Create(NumberExtensions.NegativeFormat(totalAmount))&nbsp; </span>
            </td>
        </tr>
        @if (invoiceModel.IsSignature)
        {
            <tr>
                <td colspan="10" rowspan="3" class="border-all">
                    <table class="table-no-signature">
                        <tr>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="col-align-left bold">
                                For Telegraphic Transfer Payments
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Beneficiary<br />
                                Beneficiary Bank<br />
                                Account Number<br />
                                IBAN<br />
                                Swift Code
                                <br />
                                <br />
                                Correspondent<br />
                                Swift Code<br />
                                <br />
                                <br />
                            </td>
                            <td colspan="4">
                                :&nbsp;&nbsp; @invoiceModel.Operator.Benificiary<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.BenificiaryBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.AccountNumber<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.IBAN<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.SwiftCode
                                <br />
                                <br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentSwiftCode<br />
                                <br />
                                <br />
                            </td>
                        </tr>
                    </table>
                </td>
                <td colspan="6" class="border-all vertical-align-top">
                    <br />
                    Prepared By:
                    <br />
                    <br />
                    <br />
                </td>
            </tr>
            <tr>
                <td colspan="6" class="border-all vertical-align-top">
                    <span class="bold">Accounting Department:</span>
                    <br />
                    <br />
                    Approved By:
                    <br />
                    <br />
                    <br />
                    <br />
                    <br />
                </td>
            </tr>
            <tr>
                <td colspan="6" class="border-all vertical-align-top bold">
                    Authorized Signatory
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="16" class="border-all">
                    <table class="table-no-signature">
                        <tr>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                            <td>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="col-align-left bold">
                                For Telegraphic Transfer Payments
                            </td>
                        </tr>
                        <tr>
                            <td>
                                Beneficiary<br />
                                Beneficiary Bank<br />
                                Account Number<br />
                                IBAN<br />
                                Swift Code
                                <br />
                                <br />
                                Correspondent<br />
                                Swift Code<br />
                                <br />
                                <br />
                            </td>
                            <td colspan="4">
                                :&nbsp;&nbsp; @invoiceModel.Operator.Benificiary<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.BenificiaryBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.AccountNumber<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.IBAN<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.SwiftCode
                                <br />
                                <br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentBank<br />
                                :&nbsp;&nbsp; @invoiceModel.Operator.CorrespondentSwiftCode<br />
                                <br />
                                <br />
                            </td>
                        </tr>
                        <tr>
                            <td>
                            </td>
                            <td colspan="4" class="no-signature">
                                This is a computer generated invoice. No signature is required.
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        }
        <tr>
            <td colspan="16" class="vertical-align-middle height50">
                @MvcHtmlString.Create(invoiceModel.Note)
            </td>
        </tr>
    </table>
</div>
