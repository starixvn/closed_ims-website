                 @detail.Reference
                 <br />
                </td>
                <td class="@boderclass" colspan="4" style='vertical-align: top; text-align: right;'>
                    <br />
                    @{totalAmount += detail.Amount;}
                    @if (state.StatementID != 100000)
                    {
                         @MvcHtmlString.Create((detail.Amount == 0 && detail.DiscountItem) ? "(nil)" : NegativeFormat(detail.Amount))
                    }
                    &nbsp;<br />
                </td>
            </tr>
            }
