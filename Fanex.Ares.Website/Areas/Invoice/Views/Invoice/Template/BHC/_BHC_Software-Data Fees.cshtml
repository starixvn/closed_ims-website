        @for (int i = 0; i < invoiceModel.StatementList.Count; i++)
        {
            Statement state = invoiceModel.StatementList[i];
            string boderclass = string.Empty;

            int lastStatementCount = invoiceModel.StatementList[invoiceModel.StatementList.Count - 1].StatementDetailList.Count - 1;
            for (int j = 0; j < state.StatementDetailList.Count; j++)
            {
                StatementDetail detail = state.StatementDetailList[j];
                if (i == 0 && j == 0)
                {
                    boderclass = "border-RLT";
                }
                else if ((i == invoiceModel.StatementList.Count - 1) && (j == lastStatementCount))
                {
                    boderclass = "border-RLB";
                }
                else
                {
                    boderclass = "border-RL";
                }

                int heightTmp = detail.DiscountItem == true ? 884 : 1284;
                
            <tr>
                <td class="@boderclass" colspan="2" style='height: 30pt; mso-height-source: userset;
                mso-height-alt: @heightTmp; vertical-align: top; text-align: center; '>
                    @if (state.StatementID != 100000)
                    {
                        if (!detail.DiscountItem)
                        {
                        <br /> @idDisplay<br />
                            idDisplay++;
                        }
                    }
                </td>
                <td class="@boderclass" colspan="7" style='vertical-align: top; text-align: left;
