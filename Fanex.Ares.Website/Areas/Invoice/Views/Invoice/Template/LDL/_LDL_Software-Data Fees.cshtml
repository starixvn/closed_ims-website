@using Fanex.Ares.Invoice.Models.Invoice;
@{
    var isCheckMappingDomail = ViewBag.isCheckMappingDomail;
    string domain = HtmlHelperExtensions.GetFullDomainURL(isCheckMappingDomail);
    var invoiceModel = new InvoiceModel();
    invoiceModel = Model;
    double totalAmount = 0;
    int idDisplay = 1;
    string descript = "Software & Data Licensing & Data transmission fees for ";
    int count = invoiceModel.StatementList.Count;

    List<StatementDetail> emptyStatementList = new List<StatementDetail>();
    emptyStatementList.Add(new StatementDetail
    {
        DiscountItem = false,
        AdjustItem = true
    });

    int limitRows = 0;
    for (int i = 0; i < invoiceModel.StatementList.Count; i++)
    {
        Statement state = invoiceModel.StatementList[i];
        for (int j = 0; j < state.StatementDetailList.Count; j++)
        {
            limitRows++;
        }
    }
    while (limitRows < 5)
    {
        invoiceModel.StatementList.Add(new Statement
        {
            StatementID = 100000,
            StatementDetailList = emptyStatementList

        });
        limitRows++;
    }
}
@functions {
    public string NegativeFormat(double input)
    {
        string output = string.Empty;

        output = input >= 0 ? "<span style=\"font-weight: bold;\">" + Converter.To<string>(input.Format(2)) + "</span>" : "<span style=\"color: red;font-weight: bold;\">(" + Converter.To<string>((input * -1).Format(2)) + ")</span>";

        return output;
    }
}
