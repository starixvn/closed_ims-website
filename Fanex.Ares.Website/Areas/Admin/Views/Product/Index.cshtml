﻿@using Fanex.Ares.Core.Resources;
@using Fanex.Ares.Core.Web;
@using Fanex.Ares.Core.Services.Impl;
@using Fanex.Ares.Report.Criteria.LicenseeSettlement;
@using Fanex.Ares.Core.Extensions
@model List<Fanex.Ares.Admin.Models.Product.ProductModel>
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    ViewBag.Title = "Manage Product";
    var errCode = string.Empty;
    var errMsg = string.Empty;
    if (TempData != null && TempData["Result"] != null )
    {
        errCode = ((System.Collections.Hashtable)TempData["Result"])["errcode"].ToString1();
        errMsg = ((System.Collections.Hashtable)TempData["Result"])["errmsg"].ToString1();
    }

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link href="~/Areas/Admin/Views/Product/Styles/Product.css" rel="stylesheet" type="text/css" />
}
@section Headline {
    <div class="title">
        <div>
            <span>Setting/ </span><span class="curr">@ViewBag.Title </span>
        </div>
    </div>
}
<div id="filter-bar" class="filter-bar" style="width: 1260px;">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="submit col_3">
                    <input id="btnAddNew" name="btnAddNew" type="button" class="ui-button" value="Add New" />
                </div>
            </div>
        </div>
    </div>
</div>
<div style="clear: both;">
</div>
<div id="numberGameWLByDateGrid" class="content-grid width-100percent">
    <div id="ProductsContainer" class="freegrid">
    </div>
</div>
@Html.Action("_AddNew")
<input id="ErrCode" type="hidden" value="@errCode" />
<input id="ErrMsg" type="hidden" value="@errMsg" />
@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2007, 1, 1).ToShortDateString())';
        var maxDate = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var notemessage = '@Html.Raw(LicenseeResource.LicenseeSettlementNoteMessage)';
    </script>
}
@section Foot {
    @Scripts.Render("~/Scripts/_Libs/multiselect", "~/Scripts/_Libs/nexDatePicker", "~/Scripts/_Libs/monPickr")
    <script type="text/javascript" src="~/scripts/_libs/tooltip/jquery.tipsy.js"></script>
    <script type="text/javascript" src="~/Areas/Admin/Views/Product/Scripts/ProductManager.js?ver=1"></script>
}
