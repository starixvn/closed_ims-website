﻿@using Fanex.Ares.Core.Resources;
@using Fanex.Ares.Core.Web;
@using Fanex.Ares.Core.Services.Impl;
@using Fanex.Ares.Report.Criteria.LicenseeSettlement;
@using Fanex.Ares.Core.Extensions
@model Fanex.Ares.Admin.Criteria.Setting.IMS_LicenseeProductSettingInfoSel
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    ViewBag.Title = "Manage Setting";
    var errCode = string.Empty;
    var errMsg = string.Empty;
    if (TempData != null && TempData["Result"] != null)
    {
        errCode = ((System.Collections.Hashtable)TempData["Result"])["errcode"].ToString1();
        errMsg = ((System.Collections.Hashtable)TempData["Result"])["errmsg"].ToString1();
    }

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    <link href="~/Areas/Admin/Views/Setting/Styles/Setting.css" rel="stylesheet" type="text/css" />
}
@section Headline {
    <div class="title">
        <div>
            <span>Seeting/ </span><span class="curr">@ViewBag.Title </span>
        </div>
    </div>
}
<div id="filter-bar" class="filter-bar" style="width: 1260px;">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                @using (Html.BeginForm("GetAllSettings", "Setting", FormMethod.Post, new { id = "formSearch" }))
                {
                <div class="lbl-field col_2 align-right">
                    <label for="LicenseeID">
                        Licensee</label>
                </div>
                <div class="edit-field col_6 align-left">
                    @Html.DropDownListFor(model => model.LicenseeID, (IEnumerable<SelectListItem>)ViewBag.lstLicensees, new SelectListItem() { Selected = true, Value = "0", Text = "All" }, new { id = "LicenseeID", @class = "select ui-widget-content ui-corner-all" })
                </div>
                <div class="lbl-field col_2 align-right">
                    <label for="PartyID">
                        Party</label>
                </div>
                <div class="edit-field col_6 align-left">
                    @Html.DropDownListFor(model => model.PartyID, (IEnumerable<SelectListItem>)ViewBag.lstParties, new SelectListItem() { Selected = true, Value = "0", Text = "All" }, new { id = "PartyID", @class = "select ui-widget-content ui-corner-all" })
                </div>
                <div class="submit col_4">
                    <input id="btnSearch" name="btnSearch" type="button" class="ui-button" value="Search" />
                </div>
                <div class="submit col_3">
                    <input id="btnAddNew" name="btnAddNew" type="button" class="ui-button" value="Add New" />
                </div>
                }
            </div>
        </div>
    </div>
</div>
<div style="clear: both;">
</div>
<div id="numberGameWLByDateGrid" class="content-grid width-100percent">
    <div id="SettingsContainer" class="freegrid">
    </div>
</div>
@Html.Action("_AddNew")
<div id="LicenseeProductChargeDialog" class="model-dialog" title="Add new Licensee"
    style="display: none; background-color: #EDECEA;">
    @Html.Action("_LicenseeProductCharge")
</div>
<div id="LicenseeProductDiscountDialog" class="model-dialog" title="Add new Licensee"
    style="display: none; background-color: #EDECEA;">
    @Html.Action("_LicenseeProductDiscount")
</div>
<input id="ErrCode" type="hidden" value="@errCode" />
<input id="ErrMsg" type="hidden" value="@errMsg" />
@section scripts
{
    <script type="text/javascript">
        var labelFrom = '@Labels.From';
        var labelTo = '@Labels.To';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2007, 1, 1).ToShortDateString())';
        var maxDate = '@DateTime.Today.AddDays(-1).ToShortDateString()';
        var notemessage = '@Html.Raw(LicenseeResource.LicenseeSettlementNoteMessage)';

        function isNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            if (charCode > 31 && (charCode < 48 || charCode > 57))
                return false;

            return true;
        }        
    </script>
}
@section Foot {
    @Scripts.Render("~/Scripts/_Libs/multiselect", "~/Scripts/_Libs/nexDatePicker", "~/Scripts/_Libs/monPickr")
    <script type="text/javascript" src="~/scripts/_libs/tooltip/jquery.tipsy.js"></script>
    <script type="text/javascript" src="~/Areas/Admin/Views/Setting/Scripts/SettingManager.js?ver=1"></script>
}
