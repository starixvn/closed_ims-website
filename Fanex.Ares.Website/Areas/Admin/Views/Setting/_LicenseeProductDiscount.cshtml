@using System.Collections;
@using (Html.BeginForm("CreateLicenseeProductDiscount", "Setting", FormMethod.Post, new { id = "formLicenseeProductDiscount" }))
{
    <table border="1" style="width: 100%;">
        <thead>
            <tr>
                <th>
                    No
                </th>
                <th>
                    Currency
                </th>
                <th>
                    From Total Amount
                </th>
                <th>
                    To Total Amount
                </th>
                <th>
                    DiscountRate
                </th>
            </tr>
        </thead>
        <tbody>
            <tr onkeyup="deleteRow(event, this, 'formLicenseeProductDiscount')">
                <td class="No">
                    1
                </td>
                <td>
                    @Html.DropDownList("Currency", (IEnumerable<SelectListItem>)ViewBag.lstCurrencies, new { id = "Currency", style = "width:100%" })
                </td>
                <td>
                    <input style="float: left; width: 95%; text-align: right;" type="text" id="FromTotalAmount"
                        name="FromTotalAmount" value="" onkeypress="return isNumberKey(event)" />
                </td>
                <td>
                    <input style="float: left; width: 95%; text-align: right;" type="text" id="ToTotalAmount"
                        name="ToTotalAmount" value="" onkeypress="return isNumberKey(event)" />
                </td>
                <td>
                    <input style="float: left; width: 90%; text-align: right;" type="text" id="DiscountRate"
                        name="DiscountRate" value="" onkeypress="return isNumberKey(event)" maxlength="3" />&nbsp%
                </td>
            </tr>
        </tbody>
    </table>
    <br />
    <input type="button" id="btnAddRow" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only"
        value="Add row" style="float: right" onclick="addNewRow('formLicenseeProductDiscount');" />
    <input type="hidden" id="PartyID" name="PartyID" value="@ViewBag.PartyID" />
    <input type="hidden" id="LicenseeID" name = "LicenseeID" value="@ViewBag.LicenseeID" />
    <input type="hidden" id="ProductID" name = "ProductID" value="@ViewBag.ProductID" />
    <input type="hidden" id="XmlSettings" name="XmlSettings" value="" />
}