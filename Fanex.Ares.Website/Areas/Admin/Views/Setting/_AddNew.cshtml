@using System.Collections;
@using Fanex.Ares.Admin.Criteria;
@model Fanex.Ares.Admin.Criteria.Setting.IMS_LicenseeProductSettingIns
<div id="AddNewDialog" class="model-dialog" title="Edit Setting" style="display: none">
    <div id="validateTips" class="validateTips">
    </div>
    @using (Html.BeginForm("CreateNewSetting", "Setting", FormMethod.Post, new { id = "formSetting" }))
    {
        <fieldset>
            <span class="update">
                <label for="LicenseeID">
                    Licensee ID</label>
                @Html.DropDownListFor(model => model.LicenseeID, (IEnumerable<SelectListItem>)ViewBag.lstLicensees, new { id = "LicenseeID", @class = "select ui-widget-content ui-corner-all" })
                <label for="PartyID">
                    Party ID</label>
                @Html.DropDownListFor(model => model.PartyID, (IEnumerable<SelectListItem>)ViewBag.lstParties, new { id = "PartyID", @class = "select ui-widget-content ui-corner-all" })
                <label for="ProductID">
                    Product ID</label>
                @Html.DropDownListFor(model => model.ProductID, (IEnumerable<SelectListItem>)ViewBag.lstProducts, new { id = "ProductID", @class = "select ui-widget-content ui-corner-all" })
            </span>
            <label for="FirstBillingDate">
                First Billing Date</label>
            @*<div id="FirstBillingDate" class="datepicker"></div>*@
            @Html.TextBoxFor(m => m.FirstBillingDate, new { id = "FirstBillingDate", @class = "text ui-widget-content ui-corner-all" })
            <label for="HeadOfTerms">
                Head Of Terms</label>
            @*<div id="HeadOfTerms" class="datepicker"></div>*@
            @Html.TextBoxFor(m => m.HeadOfTerms, new { id = "HeadOfTerms", @class = "text ui-widget-content ui-corner-all" })
            <label for="MinimumFee">
                Minimum Fee</label>
            @Html.TextBoxFor(m => m.MinimumFee, new { id = "MinimumFee", @class = "text ui-widget-content ui-corner-all", onkeypress = "return isNumberKey(event)" })
            <label for="WaivedDate">
                Waived Date</label>
            @*<div id="WaivedDate" class="datepicker"></div>*@
            @Html.TextBoxFor(m => m.WaivedDate, new { id = "WaivedDate", @class = "text ui-widget-content ui-corner-all" })
            <label for="WaivedMonth">
                Waived Month</label>
            @Html.TextBoxFor(m => m.WaivedMonth, new { id = "WaivedMonth", @class = "text ui-widget-content ui-corner-all", onkeypress = "return isNumberKey(event)" })
            <label for="Currency">
                Currency</label>
            @Html.DropDownListFor(m => m.Currency, (IEnumerable<SelectListItem>)ViewBag.lstCurrencies, new { id = "Currency", @class = "select ui-widget-content ui-corner-all" })
        </fieldset>
    }
</div>
