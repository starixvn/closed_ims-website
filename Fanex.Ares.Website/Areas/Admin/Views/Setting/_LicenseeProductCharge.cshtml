@using System.Collections;
@using (Html.BeginForm("CreateLicenseeProductCharge", "Setting", FormMethod.Post, new { id = "formLicenseeProductCharge" }))
{
    <table border="1" style="width: 100%;">
        <thead>
            <tr>
                <th>
                    No
                </th>
                <th>
                    Distributer Rate&nbsp;(%)
                </th>
                <th>
                    Partner Rate&nbsp;(%)
                </th>
                <th>
                    ONEWorks Rate&nbsp;(%)
                </th>
                <th>
                    Start Date
                </th>
                <th>
                    End Date
                </th>
                <th>
                    Charge Type
                </th>
                <th>
                    Billing Currency
                </th>
                <th>
                    Description
                </th>
            </tr>
        </thead>
        <tbody>
            <tr onkeyup="deleteRow(event, this, 'formLicenseeProductCharge')">
                <td class="No">
                    1
                </td>
                <td style="text-align:center; width: 80px;">
                    <input style="float: left; width: 80px; text-align: right;" type="text" id="DistributorRate"
                        name="DistributorRate" value="" onkeypress="return isNumberKey(event)" maxlength="3" />
                </td>
                <td style="text-align:center; width: 80px;">
                    <input style="float: left; width: 80px; text-align: right;" type="text" id="PartnerRate"
                        name="PartnerRate" value="" onkeypress="return isNumberKey(event)" maxlength="3" />
                </td>
                <td style="text-align:center; width: 80px;">
                    <input style="float: left; width: 80px; text-align: right;" type="text" id="ONEWorksRate"
                        name="ONEWorksRate" value="" onkeypress="return isNumberKey(event)" maxlength="3" />
                </td>
                <td>
                    <input type="text" id="StartDate" class="date" name="StartDate" value="" style="width:100px;" />
                </td>
                <td>
                    <input type="text" id="EndDate" class="date" name="EndDate" value=""  style="width:100px;" />
                </td>
                <td>
                    <select id="ChargeType" name="ChargeType">
                        <option value="1">Distributor's revenue</option>
                        <option value="2">GrossWin</option>
                        <option value="3">NetWin</option>
                    </select>
                </td>
                <td>
                    @Html.DropDownList("BillingCurrency", (IEnumerable<SelectListItem>)ViewBag.lstCurrencies, new { id = "BillingCurrency", style = "width:70px" })
                </td>
                <td>                
                    <textarea name="Description"  style="width:200px;" rows="1" cols="0" id="Description" maxlength="300" class="text ui-widget-content ui-corner-all"></textarea>
                </td>
            </tr>
        </tbody>
    </table>
    <br />
    <input type="button" id="btnAddRow" class="ui-button ui-widget ui-state-default ui-corner-all ui-button-text-only"
        value="Add row" style="float: right" onclick="addNewRow('formLicenseeProductCharge');" />
    <input type="hidden" id="PartyID" name="PartyID" value="@ViewBag.PartyID" />
    <input type="hidden" id="LicenseeID" name = "LicenseeID" value="@ViewBag.LicenseeID" />
    <input type="hidden" id="ProductID" name = "ProductID" value="@ViewBag.ProductID" />
    <input type="hidden" id="XmlSettings" name="XmlSettings" value="" />
}