@using System.Collections;

    @using (Html.BeginForm("CreatePartyLicensee", "Party", FormMethod.Post, new { id = "formPartyLicensee" }))
    {
        <table style="border-collapse: collapse">
            <tbody>
                <tr>
                    <td style="padding-left: 0; border: none;">
                        <label for="available_columns" style="font-weight: bold;">
                            Available Licensees</label>
                        <br />
                        @Html.DropDownList("available_columns[]", (IEnumerable<SelectListItem>)ViewBag.lstAvailableLicensee, new { multiple = "multiple", id = "available_columns", ondblclick = "moveOptions(document.getElementById('available_columns'), document.getElementById('selected_columns'));", size = "10", style = "width: 150px" })
                    </td>
                    <td class="buttons" style="border: none;">
                        <input value="→" onclick="moveOptions(document.getElementById('available_columns'), document.getElementById('selected_columns'));"
                            type="button" /><br />
                        <input value="←" onclick="moveOptions(document.getElementById('selected_columns'), document.getElementById('available_columns'));"
                            type="button" />
                    </td>
                    <td style="border: none;">
                        <label for="selected_columns" style="font-weight: bold;">
                            Selected Licensees</label>
                        <br />
                        @Html.DropDownList("c[]", (IEnumerable<SelectListItem>)ViewBag.lstSelectedLicensee, new { multiple = "multiple", id = "selected_columns", ondblclick = "moveOptions(document.getElementById('selected_columns'), document.getElementById('available_columns'));", size = "10", style = "width: 150px" })
                    </td>
                </tr>
            </tbody>
        </table>
        <input type="hidden" id="PartyID" name="PartyID" value="@ViewBag.PartyID" />
        <input type="hidden" id="XmlSettings" name = "XmlSettings" value="" />
    }