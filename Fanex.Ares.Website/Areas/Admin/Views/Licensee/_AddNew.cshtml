@using System.Collections;
<div id="AddNewDialog" class="model-dialog" title="Edit Licensee" style="display: none">
    <div id="validateTips" class="validateTips">
    </div>
    @using (Html.BeginForm("CreateNewLicensee", "Licensee", FormMethod.Post, new { enctype = "multipart/form-data", id = "formLicensee" }))
    {
        <fieldset>
            <label for="LicenseeID">
                Licensee ID</label>
            @Html.DropDownList("LicenseeID", (IEnumerable<SelectListItem>)ViewBag.lstLicensees, new { id = "LicenseeID", @class = "select ui-widget-content ui-corner-all" })
            <span class="update">
                <label for="LicenseeName">
                    Licensee Name</label>
                <input type="text" name="LicenseeName" id="LicenseeName" maxlength="30" class="text ui-widget-content ui-corner-all" />
                <label for="BrandName">
                    Brand Name</label>
                <input type="text" name="BrandName" id="BrandName" maxlength="50" class="text ui-widget-content ui-corner-all" />
                <label for="CompanyName">
                    Company Name</label>
                <input type="text" name="CompanyName" id="CompanyName" maxlength="100" class="text ui-widget-content ui-corner-all" />
                <label for="IsDeposit">
                    Is Deposit</label>
                <input type="checkbox" name="IsDeposit" id="IsDeposit" class="ui-widget-content ui-corner-all"
                    value="true" />
            </span>
            <label for="IsActive">
                Is Active</label>
            <input type="checkbox" name="IsActive" id="IsActive" class="ui-widget-content ui-corner-all"
                value="true" />
            <label for="IsOneWorkActive">
                Is One Work Active</label>
            <input type="checkbox" name="IsOneWorkActive" id="IsOneWorkActive" class="ui-widget-content ui-corner-all"
                value="true" />
            <label for="AttnName">
                Attn Name</label>
            <input type="text" name="AttnName" id="AttnName" maxlength="50" class="text ui-widget-content ui-corner-all" />
            <label for="To1">
                To1</label>
            <textarea name="To1" rows="5" cols="0" id="To1" maxlength="100" class="text ui-widget-content ui-corner-all"></textarea>
            <label for="To2">
                To2</label>
            <textarea name="To2" rows="5" cols="0" id="To2" maxlength="100" class="text ui-widget-content ui-corner-all"></textarea>
        </fieldset>
    }
</div>
