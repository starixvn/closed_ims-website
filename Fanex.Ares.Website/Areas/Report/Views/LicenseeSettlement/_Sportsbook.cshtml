@using Fanex.Ares.Report.ViewModels.LicenseeSettlement;
@using Fanex.Ares.Report.ViewModels;
@using Fanex.Ares.Core.Extensions;
@using Resource;
@{
    LicenseeSettlementModel licensee = new LicenseeSettlementModel();
    licensee = Model;
}
@functions{
    public string GetNegativeClass(double number)
    {
        return number < 0 ? "negative-number" : string.Empty;
    }

    public string GetEvenClass(int number)
    {
        return number % 2 == 0 ? "background-color: #e4f2fd;" : string.Empty;
    }
}
<div class="div-content" style="overflow-x: hidden">
    <table border="0" cellpadding="0" cellspacing="0" width="1019px" style='border-collapse: collapse;
        table-layout: fixed; width: 800pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2084; width: 50pt'>
        <col style='mso-width-source: userset; mso-width-alt: 1718; width: 40pt'>
        <col style='mso-width-source: userset; mso-width-alt: 3181; width: 80pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2340; width: 50pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2633; width: 80pt'>
        <col style='mso-width-source: userset; mso-width-alt: 1355; width: 50pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2633; width: 80pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2633; width: 80pt'>
        <col style='mso-width-source: userset; mso-width-alt: 1355; width: 50pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2669; width: 80pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2669; width: 80pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2669; width: 80pt'>
        <col style='mso-width-source: userset; mso-width-alt: 1536; width: 40pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2433; width: 50pt'>
        <col style='mso-width-source: userset; mso-width-alt: 2433; width: 50pt'>
        <tr style='height: 16.5pt'>
            <td colspan="15" class="xl65" colspan="5" style='height: 16.5pt;'>
                INTERNAL WORKSHEET FOR SETTLEMENT
            </td>
        </tr>
        <tr>
            <td colspan="3" style='height: 12.75pt;'>
                Finance Department
            </td>
            <td colspan="12">
            </td>
        </tr>
        <tr>
            <td colspan="15" style='height: 12.75pt;'>
            </td>
        </tr>
        <tr>
            <td colspan="3" style='height: 12.75pt;'>
                SETTLEMENT REPORT
            </td>
            <td colspan="3">
                From @licensee.LicenseeInfor.FromDate.ToAresDayMonthYear()
                To @licensee.LicenseeInfor.ToDate.ToAresDayMonthYear()
            </td>
            <td colspan="9">
            </td>
        </tr>
        <tr>
            <td colspan="2" style='height: 12.75pt;'>
                LICENSEE:
            </td>
            <td class="xl67">
                @licensee.LicenseeInfor.LicenseeName
            </td>
            <td class="xl68" colspan="2">
                @licensee.LicenseeInfor.ProductName.ToUpper()
            </td>
            <td colspan="2">
                1st Billing:
            </td>
            <td class="xl66">
                @licensee.LicenseeInfor.FirstBilling.ToAresMonthYear()
            </td>
            <td colspan="8">
            </td>
        </tr>
        <tr>
            <td colspan="5" style='height: 12.75pt;'>
            </td>
            <td colspan="2">
                Basis of Billing:
            </td>
            <td class="xl66" colspan="2">
                15% of Net Win
            </td>
            <td colspan="6">
            </td>
        </tr>
        <tr>
            <td colspan="15" style='height: 12.75pt;'>
            </td>
        </tr>
        <tr>
            <td colspan="5" style='height: 12.75pt;'>
            </td>
            <td colspan="2">
                Minimum Fees:
            </td>
            <td class="xl66" colspan="6">
                @licensee.LicenseeInfor.MinimumFees
            </td>
            <td colspan="2">
            </td>
        </tr>
        <tr height="17" style='height: 12.75pt'>
            <td height="17" colspan="5" style='height: 12.75pt; mso-ignore: colspan'>
            </td>
            <td colspan="2" style='mso-ignore: colspan'>
                Head of Terms:
            </td>
            <td class="xl66">
                @licensee.LicenseeInfor.HeadOfTerms
            </td>
            <td colspan="7" >
            </td>
        </tr>
        <tr >
            <td colspan="15" style='height: 12.75pt;'>
            </td>
        </tr>
        <tr>
            <td rowspan="2" class="xl75" style='height: 26pt'>
                @Labels.Date
            </td>
            <td rowspan="2" class="xl76">
                @Labels.Currency
            </td>
            <td rowspan="2" class="xl77">
                @Labels.Turnover
            </td>
            <td rowspan="2" class="xl77">
                @Labels.TotalTrans
            </td>
            <td colspan="3" class="xl77">
                @Labels.Member
            </td>
            <td colspan="3" class="xl77">
                @licensee.LicenseeInfor.LicenseeName
            </td>
            <td rowspan="2" class="xl77">
                @Labels.Company
            </td>
            <td rowspan="2" class="xl78">
                @licensee.LicenseeInfor.BaseCurrencyName
            </td>
            <td class="xl69">
            </td>
            <td colspan="2" class="xl80">
                @{
                    string forexTime = string.Empty;
                    if (DateTime.Now.Month == licensee.LicenseeInfor.SettlementDate.Month)
                    {
                        forexTime = DateTime.Now.ToAresDayMonthYear();
                    }
                    else
                    {
                        forexTime = licensee.LicenseeInfor.SettlementDate.LastDayOfMonth().ToAresDayMonthYear();
                    }
                }
                Forex @@ @forexTime
            </td>
        </tr>
        <tr>
            <td class="xl73">
                @Labels.WinLoss
            </td>
            <td class="xl73">
                @Labels.Comm
            </td>
            <td class="xl73">
                @Labels.Total
            </td>
            <td class="xl73">
                @Labels.WinLoss
            </td>
            <td class="xl73">
                @Labels.Comm
            </td>
            <td class="xl73">
                @Labels.Total
            </td>
            <td class="xl69">
            </td>
            <td class="xl101">
                @licensee.LicenseeInfor.BaseCurrencyName/1 Unit
            </td>
            <td class="xl102">
                Units/1 @licensee.LicenseeInfor.BaseCurrencyName
            </td>
        </tr>
        @if (licensee.Report.EntityList.Count == 0)
        {
            <tr class="colborder01">
                <td class="cellstyle aligncenter" colspan="15">
                    There is no data
                </td>
            </tr>
        }
        @for (int i = 0; i < licensee.Report.EntityList.Count; i++)
        {
            ReportEntity report = new ReportEntity();
            report = licensee.Report.EntityList[i];

            ExchangeRate exchange = new ExchangeRate();
            exchange = licensee.ExchangeList[i];

            var evenClass = GetEvenClass(i);
            
            <tr>
                <td height="17" class="xl91" style='height: 15pt; @evenClass'>
                    @report.WinlostDate.ToAresDayMonthYear()
                </td>
                <td class="xl83" style="@evenClass">
                    @report.CurrencyName
                </td>
                <td class="xl84" style="@evenClass">
                    @report.Turnover.Format(2)
                </td>
                <td class="xl85" style="@evenClass">
                    @report.Betcount.Format(0)
                </td>
                <td class="xl84" style="@evenClass">
                    <span class="@GetNegativeClass(report.MemberWinloss)">@report.MemberWinloss.FormatNegative(2)</span>
                </td>
                <td class="xl86" style="@evenClass">
                    @if (report.MemberComm != 0)
                    {
                        @report.MemberComm.Format(2);
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="xl84" style="@evenClass">
                    <span class="@GetNegativeClass(report.MemberTotal)">@report.MemberTotal.FormatNegative(2)</span>
                </td>
                <td class="xl84" style="@evenClass">
                    <span class="@GetNegativeClass(report.LicenseeWL)">@report.LicenseeWL.FormatNegative(2)</span>
                </td>
                <td class="xl86" style="@evenClass">
                    @if (report.LicenseeComm != 0)
                    {
                        @report.LicenseeComm.Format(2);
                    }
                    else
                    { 

                        <span>-</span>
                    }
                </td>
                <td class="xl84" style="@evenClass">
                    <span class="@GetNegativeClass(report.LicenseeTotal);">@report.LicenseeTotal.FormatNegative(2)</span>
                </td>
                <td class="xl84" style="@evenClass">
                    <span class="@GetNegativeClass(report.Company);">@report.Company.FormatNegative(2)</span>
                </td>
                <td class="xl92" style="@evenClass">
                    <span class="@GetNegativeClass(report.CompanyBaseCurrency);">@report.CompanyBaseCurrency.FormatNegative(2)</span>
                </td>
                <td class="xl70">
                    @exchange.CurrencyName
                </td>
                <td class="xl91" style="@evenClass">
                    @exchange.BasePerUnit.Format(5)
                </td>
                <td class="xl92" style="@evenClass">
                    @exchange.UnitsPerBase.Format(5)
                </td>
            </tr>
        }
        <tr>
            <td colspan="12" align="right" class="xl72" style='height: 15pt'>
                @licensee.Report.GrandTotal.CompanyBaseCurrency.FormatNegative(2)
            </td>
            <td>
            </td>
            <td class="xl200" colspan="2">
            </td>
        </tr>
        <tr>
            <td colspan="15" style='height: 10pt'>
            </td>
        </tr>
        @if (licensee.LicenseeInfor.BaseCurrencyName.Trim() != "CNY")
        {
            <tr>
                <td colspan="12" style='height: 15pt'>
                    IDR &amp; VND * Amount in IDR is stated in 000, when converted to @licensee.LicenseeInfor.BaseCurrencyName
                    Equv, x1000
                </td>
                <td colspan="3">
                </td>
            </tr>

            <tr>
                <td colspan="12" style='height: 15pt;'>
                    FOREX www.oanda.com provided minor difference between '@licensee.LicenseeInfor.BaseCurrencyName/1
                    Unit' vs 'Units/1 @licensee.LicenseeInfor.BaseCurrencyName', we standardize the
                    use of 'Units/1 @licensee.LicenseeInfor.BaseCurrencyName' rate to prevail all.
                </td>
                <td colspan="3">
                </td>
            </tr>
        }
    </table>
</div>
