﻿@using Fanex.Ares.Core.Resources;
@using Fanex.Ares.Core.Web;
@using Fanex.Ares.Core.Services.Impl;
@using Fanex.Ares.Report.Controllers
@using Fanex.Ares.Report.Criteria.LicenseeSettlement;
@using Fanex.Ares.Core.Extensions
@model ReportLicenseeSettlementCriteria
@{
    ViewBag.Title = "Licensee Settlement Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/bundles/LicenseeSettlementCss")
}
@section Headline {
    <div class="title">
        <div>
            <span>Invoice System / </span><span class="curr">@ViewBag.Title </span>
        </div>
    </div>
}
<div>
    @using (Html.BeginForm("Home", "Index", FormMethod.Post, new { id = "formLicenseeSettlement", autocomplete = "off" }))
    {
        <div id="filter-bar" class="filter-bar" style="width: 1260px;">
            <span id="notemessage" class="note-info-message" title=''></span>
            <div class="filter-form">
                <div class="filter-row">
                    <div class="filter-cell">
                        <div class="lbl-field col_3 align-right">
                            @Html.LabelFor(m => m.LicenseeId, "Licensee")
                        </div>
                        <div class="edit-field col_6 align-left">
                            @Html.DropDownListFor(m => m.LicenseeId, ((List<Fanex.Ares.Core.Models.SelectListItemExtension>)ViewBag.ListLicenseeEx).ToListSelectListItem(), new SelectListItem() { Selected = true, Text = "Please Choose One !", Value = "0" }, new { @class = "alpha auto-width" })
                        </div>
                        <div class="lbl-field col_3">
                            <div>
                                Month</div>
                        </div>
                        <div class="edit-field col_16">
                            <div id="ddlMonth">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="filter-row">
                    <div class="lbl-field col_3 align-right">
                        @Html.LabelFor(m => m.Product, "Product")
                    </div>
                    <div class="edit-field col_6 align-left">
                        @Html.DropDownListFor(m => m.Product, (IEnumerable<SelectListItem>)ViewBag.ListProduct, new { @class = "alpha auto-width" })
                    </div>
                    <div class="lbl-field col_3 align-right">
                        @Html.LabelFor(m => m.Currency, "Currency")
                    </div>
                    <div class="edit-field col_6 align-left">
                        @Html.DropDownListFor(m => m.Currency, ((List<SelectListItem>)ViewBag.ListCurrency), new SelectListItem() { Selected = true, Text = "All", Value = "0" }, new { @class = "alpha auto-width" })
                    </div>
                    <div class="lbl-field col_3 align-right">
                        @Html.LabelFor(m => m.BaseCurrency, "Exchange")
                    </div>
                    <div class="edit-field col_6 align-left">
                        <select id="BaseCurrency" name="BaseCurrency">
                            @foreach (var baseCurrency in ViewBag.ListExchangeRate)
                            {
                                <option value="@baseCurrency.Value" selected="@baseCurrency.Selected">@baseCurrency.Text</option>
                            }
                        </select>
                    </div>
                    <div class="lbl-field col_3 align-right">
                    </div>
                    <div class="submit col_6">
                        <input id="btnGenerate" name="btnGenerate" type="button" value="GENERATE" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div class="grid-title" style="clear: both; display: none; margin: 85px 0 0 10px;">
    <div class="grid-title-label">
        <span id="nonLiveBingoReportTitle"></span>
    </div>
    <div class="grid-toolbox">
        @using (Html.BeginForm("ExportDocument", "LicenseeSettlement", FormMethod.Post, new { @id = "xlsForm" }))
        {
            <input style="float: right" id="btnExcel" class="btnExcel" type="submit" name="btnExcel"
                value="" title="Excel" />
        }
        @using (Html.BeginForm("ExportDocument", "LicenseeSettlement", FormMethod.Post, new { @id = "pdfForm" }))
        {
            <input style="float: right" id="btnPDF" class="btnPDF" type="submit" name="btnPDF"
                value="" title="PDF" />
        }
    </div>
</div>
<div id="parentContainer" class="content-grid">
</div>
@section Foot {
    @Scripts.Render("~/bundles/LicenseeSettlementJs")
}
@Html.Hidden("labelFrom", Labels.From)
@Html.Hidden("labelTo", Labels.To)
@Html.Hidden("today", DateTime.Today.ToShortDateString())
@Html.Hidden("minDate", new DateTime(2012, 06, 1).ToShortDateString())
@Html.Hidden("noteMessage", Html.Raw(LicenseeResource.LicenseeSettlementNoteMessage))