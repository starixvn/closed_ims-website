@using Fanex.Ares.Report.ViewModels.LicenseeSettlement;
@using Fanex.Ares.Report.ViewModels;
@using Fanex.Ares.Core.Extensions;
@using Resource;
@{
    LicenseeSettlementModel licensee = new LicenseeSettlementModel();
    licensee = Model;
}
@functions{
    public string GetNegativeClass(double number)
    {
        return number < 0 ? "negative-number" : string.Empty;
    }

    public string GetEvenClass(int number)
    {
        return number % 2 == 0 ? "background-color: #e4f2fd;" : string.Empty;
    }
}
<div class="div-content" style="overflow-x: hidden">
    <table border="0" cellpadding="0" cellspacing="0" width="1019px" style='border-collapse: collapse;'>
        <tr>
            <td colspan="14" class="boldTilte" style='height: 16.5pt;'>
                INTERNAL WORKSHEET FOR SETTLEMENT
            </td>
        </tr>
        <tr>
            <td colspan="3" style='height: 12.75pt;'>
                Finance Department
            </td>
            <td colspan="11">
            </td>
        </tr>
        <tr>
            <td colspan="15" style='height: 12.75pt;'>
            </td>
        </tr>
        <tr>
            <td colspan="3" style='height: 12.75pt;'>
                SETTLEMENT REPORT
            </td>
            <td colspan="11" class="boldInfor">
                From @licensee.LicenseeInfor.FromDate.ToAresDayMonthYear()
                To @licensee.LicenseeInfor.ToDate.ToAresDayMonthYear()
            </td>
        </tr>
        <tr>
            <td colspan="2" style='height: 12.75pt;'>
                LICENSEE:
            </td>
            <td class="licenseeName">
                @licensee.LicenseeInfor.LicenseeName
            </td>
            <td class="sportName" colspan="2">
                @licensee.LicenseeInfor.ProductName.ToUpper()
            </td>
            <td colspan="1">
                1st Billing:
            </td>
            <td class="boldInfor" colspan="8">
                @licensee.LicenseeInfor.FirstBilling.ToAresMonthYear()
            </td>
        </tr>
        <tr>
            <td colspan="5" style='height: 12.75pt;'>
            </td>
            <td colspan="1">
                Head of Terms:
            </td>
            <td class="boldInfor" colspan="8">
                @licensee.LicenseeInfor.HeadOfTerms
            </td>
        </tr>
        <tr>
            <td colspan="10" style='height: 12.75pt; border: none !important;'>
            </td>
        </tr>
        <tr>
            <td rowspan="2" class="header" style='height: 26pt'>
                @Labels.Date
            </td>
            <td rowspan="2" class="header">
                @Labels.Currency
            </td>
            <td rowspan="2" class="header">
                @Labels.Turnover
            </td>
            <td rowspan="2" class="header">
                @Labels.Turnover (@licensee.LicenseeInfor.BaseCurrencyName)
            </td>
            <td rowspan="2" class="header">
                @Labels.TotalTrans
            </td>
            <td rowspan="2" class="header">
                @Labels.CustomerWinLoss
            </td>
            <td rowspan="2" class="header">
                @Labels.CustomerWinLoss (@licensee.LicenseeInfor.BaseCurrencyName)
            </td>
            <td rowspan="2" class="header">
                @Labels.BAComm
            </td>
            <td rowspan="2" class="header">
                @Labels.BAComm (@licensee.LicenseeInfor.BaseCurrencyName)
            </td>
            <td colspan="2" class="header">
                @Labels.AmountDue
            </td>
            <td rowspan="2" class="emptyheader">
            </td>
            <td colspan="2" class="header">
                @{
                    string forexTime = string.Empty;
                    if (DateTime.Now.Month == licensee.LicenseeInfor.SettlementDate.Month)
                    {
                        forexTime = DateTime.Now.ToAresDayMonthYear();
                    }
                    else
                    {
                        forexTime = licensee.LicenseeInfor.SettlementDate.LastDayOfMonth().ToAresDayMonthYear();
                    }
                }
                Forex @@ @forexTime
            </td>
        </tr>
        <tr>
            <td class="header">
                @Labels.BA
            </td>
            <td class="header">
                @Labels.BAEqui @licensee.LicenseeInfor.BaseCurrencyName
            </td>
            <td class="header">
                @licensee.LicenseeInfor.BaseCurrencyName/1 Unit
            </td>
            <td class="header">
                Units/1 @licensee.LicenseeInfor.BaseCurrencyName
            </td>
        </tr>
        @if (licensee.Report.EntityList.Count == 0)
        {
            <tr class="colborder01">
                <td class="cellstyle aligncenter" colspan="15">
                    There is no data
                </td>
            </tr>
        }
        @for (int i = 0; i < licensee.Report.EntityList.Count; i++)
        {
            ReportEntity report = new ReportEntity();
            report = licensee.Report.EntityList[i];

            ExchangeRate exchange = new ExchangeRate();
            exchange = licensee.ExchangeList[i];

            var evenClass = GetEvenClass(i);
            
            <tr>
                <td height="17" class="colDateTime" style='height: 15pt; border-left: .5pt solid gray; @evenClass'>
                    @report.WinlostDate.ToAresDayMonthYear()
                </td>
                <td class="colText" style="@evenClass">
                    @report.CurrencyName
                </td>
                <td class="colNumber" style="@evenClass">
                    <span class=" @GetNegativeClass(report.Turnover)">@report.Turnover.Format(2)</span>
                </td>
                <td class="colNumber" style="@evenClass">
                    <span class="@GetNegativeClass(report.TurnoverBase)">@report.TurnoverBase.Format(2)</span>
                </td>
                <td class="colInteger" style="@evenClass">
                    @report.Betcount.Format(0)
                </td>
                <td class="colNumber" style="@evenClass">
                    <span class=" @GetNegativeClass(report.MemberWinloss)">@report.MemberWinloss.FormatNegative(2)</span>
                </td>
                <td class="colNumber" style="@evenClass">
                    <span class="  @GetNegativeClass(report.MemberWinlossBase)">@report.MemberWinlossBase.FormatNegative(2)</span>
                </td>
                <td class="colNumber" style="@evenClass">
                    <span class="  @GetNegativeClass(report.LicenseeWL)">@report.LicenseeWL.FormatNegative(2)</span>
                </td>
                <td class="colNumber" style="@evenClass">
                    <span class="  @GetNegativeClass(report.LicenseeWLBase)">@report.LicenseeWLBase.FormatNegative(2)</span>
                </td>
                <td class="colNumber" style="@evenClass">
                    <span class="  @GetNegativeClass(report.Company)">@report.Company.FormatNegative(2)</span>
                </td>
                <td class="colNumber" style="border-right: .5pt solid gray;@evenClass;">
                    <span class="  @GetNegativeClass(report.CompanyBaseCurrency)">@report.CompanyBaseCurrency.FormatNegative(2)</span>
                </td>
                <td class="currency">
                    @exchange.CurrencyName
                </td>
                <td class="colNumber5Odd" style="border-left: .5pt solid gray;@evenClass">
                    @exchange.BasePerUnit.Format(5)
                </td>
                <td class="colNumber5Odd" style="border-right: .5pt solid gray; @evenClass">
                    @exchange.UnitsPerBase.Format(5)
                </td>
            </tr>
        }
        <tr>
            <td colspan="4" align="right" class="grandtotal" style='height: 15pt;'>
                <span class="@GetNegativeClass(licensee.Report.GrandTotal.TurnoverBase)">@licensee.Report.GrandTotal.TurnoverBase.Format(2)</span>
            </td>
            <td colspan="3" align="right" class="grandtotal">
                <span class="@GetNegativeClass(licensee.Report.GrandTotal.MemberWinlossBase)">@licensee.Report.GrandTotal.MemberWinlossBase.FormatNegative(2)</span>
            </td>
            <td colspan="2" align="right" class="grandtotal">
                <span class="@GetNegativeClass(licensee.Report.GrandTotal.LicenseeWLBase)">@licensee.Report.GrandTotal.LicenseeWLBase.FormatNegative(2)</span>
            </td>
            <td colspan="2" align="right" class="grandtotal">
                <span class="@GetNegativeClass(licensee.Report.GrandTotal.CompanyBaseCurrency)">@licensee.Report.GrandTotal.CompanyBaseCurrency.FormatNegative(2)</span>
            </td>
            <td class="emptyCell">
            </td>
            <td class="emptytotal" style="height: 10pt;" colspan="2">
            </td>
        </tr>
        <tr>
            <td colspan="14" style='height: 10pt; border: 1pt solid white;'>
            </td>
        </tr>
        @if (licensee.LicenseeInfor.BaseCurrencyName.Trim() != "CNY")
        {
            <tr>
                <td colspan="14" style='height: 15pt'>
                    IDR &amp; VND * Amount in IDR is stated in 000, when converted to @licensee.LicenseeInfor.BaseCurrencyName
                    Equv, x1000
                </td>
            </tr>
            <tr>
                <td colspan="14" style='height: 15pt;'>
                    FOREX www.oanda.com provided minor difference between '@licensee.LicenseeInfor.BaseCurrencyName/1
                    Unit' vs 'Units/1 @licensee.LicenseeInfor.BaseCurrencyName', we standardize the
                    use of 'Units/1 @licensee.LicenseeInfor.BaseCurrencyName' rate to prevail all.
                </td>
            </tr>
        }
    </table>
</div>
