<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/bundles/CommonCss")
    <link rel="shortcut icon" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--[if lt IE 9]><script src="~/scripts/_libs/utils/html5shiv.min.js" type="text/javascript"></script><![endif]-->
    @RenderSection("Head", false)
</head>
<body>
    @if (AppSession.IsShowMenu)
    { 
        <header>
        <div class="logo">
            <a href="~/?ref=logo">&nbsp;</a>
        </div>
        @Html.Action("_Menu", new RouteValueDictionary(new { controller = "Home", area = "" }))
        <div class="user-info">
        <div class="greeting">
                <h2>
                    Howdy, <span class="info-acc">@HttpContext.Current.User.Identity.Name</span><span
                        class="info-more"></span></h2>
                <ul>
                    <li>@Html.ActionLink(ViewResources.Profile, "UserProfile", "User", new { Area = "UserControl" }, new { })</li>
                    <li>@Html.ActionLink(ViewResources.Change_Password, "ChangePassword", "User", new { Area = "UserControl" }, new { })</li>
                    <li>@Html.ActionLink(ViewResources.Sign_Out, "LogOut", "Login", new { Area = "UserLogin" }, new { })</li>
                </ul>
            </div>
              
        </div>
    </header>
    }
    <section id="headline">
        @RenderSection("Headline", false)
    </section>
    <section id="body">
        @RenderBody()
    </section>
    @Html.Hidden("NapHubRoot", Url.Content("~/"))
</body>
</html>
@Scripts.Render("~/bundles/CommonJs")
@RenderSection("Scripts", false)
@RenderSection("Foot", false)
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    window.rootWebPath = '@(Request.Url.GetLeftPart(UriPartial.Authority) + Request.ApplicationPath)';

    //Set fix width for filter-bar
    $("#filter-bar").css("width", ($(window).width() - 30) + "px");
    $(".grid-title").css("width", ($(window).width() - 30) + "px");
    $(".content-grid").css("width", ($(window).width() - 30) + "px");
    $(".content-grid").css("margin", "6px 0 0 10px");

    $(window).resize(function () {
        var width = $(window).width() - 30; //padding-right: 10 + padding-left: 10
        $("#filter-bar").css("width", width + "px");
        $(".grid-title").css("width", width + "px");
        $(".content-grid").css("margin", "6px 0 0 10px");
        $(".content-grid").css("width", width + "px");
    });
</script>
