<!DOCTYPE html>
<!--[if (IE 7)]><html lang="en" class="ie7 oldie"><![endif]-->
<!--[if (IE 8)]><html lang="en" class="ie8 oldie"><![endif]-->
<!--[if (IE 9)]><html lang="en" class="ie9"><![endif]-->
<!--[if (gt IE 9)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--[if lt IE 9]><script src="~/scripts/_libs/utils/html5shiv.min.js" type="text/javascript"></script><![endif]-->
    <link href="~/content/jquery-ui/jquery-ui-1.9.1.custom.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/scripts/_libs/fanexgrid/fanex.grid.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/_libs/fanexgrid/fanex.pagination.css" rel="stylesheet" type="text/css" />
    <link href="~/scripts/_Libs/Validation/validationEngine.jquery.css" rel="stylesheet"
        type="text/css" />
    <link href="~/Content/BetList.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/_Libs/FanexGrid/Fanex.Pagination.css" rel="stylesheet" type="text/css" />
    @RenderSection("Head", false)
    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles")
    }
    else
    {
        <link href="~/content/base/style.less" rel="stylesheet" type="text/css" />
    }
</head>
<body onload="window.print();">
    <section id="body">
        @RenderBody()
    </section>
    
</body>
</html>
@Scripts.Render("~/scripts/common")
@RenderSection("Scripts", false)
@RenderSection("Foot", false)

<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    window.rootWebPath = '@(Request.Url.GetLeftPart(UriPartial.Authority) + Request.ApplicationPath)';

    //Set fix width for filter-bar
    $("#filter-bar").css("width", ($(window).width() - 20) + "px");
    $(".grid-title").css("width", ($(window).width() - 20) + "px");
    $(".div-content").css("width", ($(window).width() - 20) + "px");
    $(window).resize(function () {
        var width = $(window).width() - 20; //padding-right: 10 + padding-left: 10
        $("#filter-bar").css("width", width + "px");
        $(".grid-title").css("width", width + "px");
        $(".div-content").css("width", width + "px");
    });
</script>